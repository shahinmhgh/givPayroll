@model CalculateViewModel

@{
    ViewData["Title"] = "محاسبه حقوق";
}

<div class="container-fluid">

    <div class="card">

        <div class="card-header">
            <h5 class="mb-0">
                محاسبه حقوق
            </h5>
        </div>

        <div class="card-body">

            <form method="get"
                  class="row g-3 mb-4">

                <div class="col-md-3">

                    <label class="form-label">
                        سال
                    </label>

                    <select name="year"
                            class="form-select">

                        @for (int year = 1400; year <= 1410; year++)
                        {
                            <option value="@year"
                                    selected="@(ViewBag.Year == year)">
                                @year
                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-2">

                    <label class="form-label">
                        ماه
                    </label>

                    <select id="attendanceMonth"
                            class="form-select"
                            asp-items="Model.Months">
                    </select>

                </div>

                @*  <div class="col-md-2 d-flex align-items-end">

                    <button type="submit"
                            class="btn btn-primary w-100">

                        <i class="fa fa-search"></i>

                        بررسی

                    </button>

                </div> *@
                <button type="button"
                        class="btn btn-primary w-100"
                        onclick="checkAttendance()">

                    <i class="fa fa-search"></i>
                    بررسی

                </button>
            </form>


            <div id="attendanceResult">
                @if (Model.Check != null && Model.Check.Any())
                {
                    <partial name="_AttendanceCheckResult" model="Model" />
                }
                else if (ViewBag.Searched == true)
                {
                    <div class="alert alert-warning">
                        پرسنلی با حکم فعال در این ماه یافت نشد.
                    </div>
                }
            </div>

       

        </div>

    </div>

   

</div>

 <div class="modal fade"
     id="attendanceModal" style="z-index: 1060 !important;">

    <div class="modal-dialog modal-xl">

        <div class="modal-content"
             id="attendanceModalContent">
        </div>

    </div>

</div>



<div class="modal fade"
     id="attendanceCheckModal"
     tabindex="-1">

    <div class="modal-dialog modal-xl">

        <div class="modal-content"
             id="attendanceCheckModalContent">
        </div>

    </div>

</div>

@section Scripts
{

    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.esm.all.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.esm.all.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.esm.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.esm.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.js"></script>
<script src="~/js/attendance.js"></script>
    <script>
        function editAttendance(id) {
            $.get(
                "/Attendance/Edit/" + id,

                function (data) {
                    $("#attendanceModalContent")
                        .html(data);


                    $.validator.unobtrusive.parse(
                        "#attendanceForm"
                    );


                    $("#attendanceModal")
                        .modal("show");
                }
            );
        }

    </script>

   <script>
    function checkAttendance() {

        const year = $('select[name="year"]').val();
        //const month = $('select[name="month"]').val();
        let month =
            $("#attendanceMonth").val();

        const button = $('button[onclick="checkAttendance()"]');

        button.prop('disabled', true);

        button.html(
            '<i class="fa fa-spinner fa-spin"></i> در حال بررسی...'
        );

        $.ajax({
            url: '@Url.Action("Check", "Attendance")',
            type: 'GET',
            data: {
                year: year,
                month: month
            },
            success: function(result) {

                $('#attendanceResult').html(result);
            },
            error: function(xhr) {

                console.error(xhr);

                $('#attendanceResult').html(`
                            <div class="alert alert-danger">
                                خطا در بررسی کارکرد پرسنل.
                            </div>
                        `);
            },
            complete: function() {

                button.prop('disabled', false);

                button.html(
                    '<i class="fa fa-search"></i> بررسی'
                );
            }
        });
    }
</script>
}

