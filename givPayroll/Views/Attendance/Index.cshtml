@model givPayroll.Models.AttendanceViewModel

@{
    ViewData["Title"] = "حضور و غیاب";
}

<link rel="stylesheet"
      href="~/pages/css/table.css" />

<link rel="stylesheet"
      href="~/pages/css/tooltip.css" />


<div class="container-fluid">

    <h2 class="mb-4">
        حضور و غیاب
    </h2>


    <!-- ===================================================== -->
    <!-- SEARCH AREA -->
    <!-- ===================================================== -->

    <div class="card mb-3">

        <div class="card-body">

            <div class="row g-2 align-items-end">

                <!-- Year -->

                <div class="col-md-2">

                    <label class="form-label">
                        سال
                    </label>

                    <select id="attendanceYear"
                            class="form-select"
                            asp-items="Model.Years">
                    </select>

                </div>


                <!-- Month -->

                <div class="col-md-2">

                    <label class="form-label">
                        ماه
                    </label>

                    <select id="attendanceMonth"
                            class="form-select"
                            asp-items="Model.Months">
                    </select>

                </div>


                <!-- Personnel -->

                <div class="col-md-4">

                    <label class="form-label">
                        پرسنل
                    </label>

                    <select id="attendancePersonnel"
                            class="form-select"
                            asp-items="Model.Personnels">

                        <option value="">
                            -- پرسنل را انتخاب کنید --
                        </option>

                    </select>

                </div>


                <!-- Search -->

                <div class="col-md-2">

                    <button id="btnSearchAttendance"
                            class="btn btn-primary w-100">

                        <i class="fa fa-search"></i>

                        جستجو

                    </button>

                </div>


                <!-- New -->
                @*    <div class="col-md-2">

                    <button id="btnNewAttendance"
                            class="btn btn-success w-100">

                        <i class="fa fa-plus"></i>

                        ثبت حضور و غیاب

                    </button>

                </div> *@

                <div class="col-md-2">

                    <button id="btnImportAttendance"
                            class="btn btn-info w-100">

                        <i class="fa fa-file-excel"></i>

                        ورود از Excel

                    </button>

                </div>

            </div>

        </div>

    </div>

    <div class="modal fade"
         id="importAttendanceModal">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        ورود حضور و غیاب از Excel
                    </h5>

                </div>


                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label">
                            سال
                        </label>

                        <select id="importYear"
                                class="form-select"
                                asp-items="Model.Years">
                        </select>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            ماه
                        </label>

                        <select id="importMonth"
                                class="form-select"
                                asp-items="Model.Months">
                        </select>

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            فایل Excel
                        </label>

                        <input type="file"
                               id="attendanceExcel"
                               class="form-control"
                               accept=".xlsx" />

                    </div>


                    <div class="alert alert-info">

                        ساختار Excel باید مطابق جدول
                        حضور و غیاب باشد.

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        انصراف

                    </button>


                    <button type="button"
                            class="btn btn-success"
                            onclick="importAttendanceExcel()">

                        <i class="fa fa-upload"></i>

                        ورود اطلاعات

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- NAVIGATION -->
    <!-- ===================================================== -->

    <div class="d-flex justify-content-between mb-3">

        <div>

            <button class="btn btn-outline-secondary"
                    onclick="previousYear()">

                <i class="fa fa-angle-right"></i>
                سال قبل

            </button>


            <button class="btn btn-outline-secondary"
                    onclick="previousMonth()">

                <i class="fa fa-chevron-right"></i>
                ماه قبل

            </button>

        </div>


        <div>

            <strong id="attendanceTitle">
                حضور و غیاب
            </strong>

        </div>


        <div>

            <button class="btn btn-outline-secondary"
                    onclick="nextMonth()">

                ماه بعد
                <i class="fa fa-chevron-left"></i>

            </button>


            <button class="btn btn-outline-secondary"
                    onclick="nextYear()">

                سال بعد
                <i class="fa fa-angle-left"></i>

            </button>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- PERSONNEL NAVIGATION -->
    <!-- ===================================================== -->

    <div class="d-flex justify-content-center mb-3">

        <button class="btn btn-outline-primary"
                onclick="previousPersonnel()">

            <i class="fa fa-user"></i>
            پرسنل قبلی

        </button>


        <button class="btn btn-outline-primary mx-2"
                onclick="nextPersonnel()">

            پرسنل بعدی
            <i class="fa fa-user"></i>

        </button>

    </div>

  

    <!-- ===================================================== -->
    <!-- TABLE -->
    <!-- ===================================================== -->

    <div id="attendanceTable">
    </div>

</div>


<!-- ========================================================= -->
<!-- MODAL -->
<!-- ========================================================= -->

<div class="modal fade"
     id="attendanceModal">

    <div class="modal-dialog modal-xl">

        <div class="modal-content"
             id="attendanceModalContent">
        </div>

    </div>

</div>



@section Scripts
{
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.esm.all.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.esm.all.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.esm.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.esm.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.js"></script>
   
    <script src="~/js/attendance.js"></script>

   
}