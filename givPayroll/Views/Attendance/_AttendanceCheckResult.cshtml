@using static AttendanceCheckViewModel
@model CalculateViewModel
<link rel="stylesheet"
      href="~/pages/css/tooltip.css" />

@{
    var actionParam = @ViewBag.actionParam;
    var ym = ViewBag.ym;
}
<div class="table-responsive">

    <table class="table table-bordered table-hover align-middle">

        <thead class="table-light">
            <tr>
                <th>پرسنل</th>
                <th>وضعیت</th>

                @{
                    switch (actionParam)
                    {
                        case "Check":
                            <th>کارکرد</th>           @* attendance     *@
                            <th>پیش نمایش</th>        @* preview        *@
                            <th>ثبت حقوق</th>         @* payroll save   *@
                            break;
                        case "CheckOk":
                            <th>تایید حقوق</th>       @* payroll ok     *@
                            @* payroll bill   *@
                            // <button type="button" class="btn btn-sm btn-primary fa fa-print" onclick="window.open('/payroll/SalaryPdf?layout=payslip&id=0&ym=@ym', '_blank')"></button>
                            <th>فیش حقوقی </th>
                            break;
                        case "CheckAcc":
                            <th>پیش نمایش</th>        @* payroll bill   *@
                            /* <th>ثبت در حسابداری</th> */  @* payroll acc    *@
                            break;
                        default:
                            break;
                    }
                }

            </tr>
        </thead>

        <tbody>

            @foreach (AttendanceCheckViewModel row in Model.Check)
            {

                var errClass = "";
                if (row.Status == AppUtil.enumAttendanceWorkStatus.Incorrect || row.Status == AppUtil.enumAttendanceWorkStatus.Incomplete)
                { errClass = "table-danger"; }

                <tr class="@errClass">

                    <td>
                        @row.PersonnelName
                    </td>
                    <td>
                        @row.StatusText
                    </td>

                    @switch (actionParam)
                    {
                        case "Check":
                            <td>
                                @* attendance     *@
                                @if (row.Status == AppUtil.enumAttendanceWorkStatus.Incorrect)
                                {
                                    <button type="button" class="btn btn-danger" onclick="buttonProc(@row.PersonnelId, '@row.IsCorrectErrText', '@row.hasWorkedErrText');">
                                        <i class="fa fa-times-circle"></i>
                                        نادرست
                                    </button>
                                }
                                else if (row.Status == AppUtil.enumAttendanceWorkStatus.Incomplete)
                                {
                                    <button type="button" class="btn btn-danger" onclick="buttonProc(@row.PersonnelId, '@row.IsCorrectErrText', '@row.hasWorkedErrText');">
                                        <i class="fa fa-times-circle"></i>
                                        ناقص
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-primary" onclick="buttonProc(@row.PersonnelId, '@row.IsCorrectErrText', '@row.hasWorkedErrText');">
                                        <i class="fa fa-calendar-check"></i>
                                        صحیح
                                    </button>
                                }
                            </td>
                            <td>
                                @* preview        *@
                                <button type="button" class="btn  btn-success" onclick="PayrollProc(@row.PersonnelId);">
                                    <i class="fa fa-calculator"></i>

                                </button>
                            </td>
                            <td>
                                @* payroll save   *@
                                @{
                                    var disable = row.Status != AppUtil.enumAttendanceWorkStatus.PayrollReadyForInsert ? "disabled" : "";
                                    // @disable
                                }

                                <button type="button" class="btn   btn-secondary  tooltip-btn " onclick="SavePayrollPersonnel(@row.PersonnelId);">
                                    <i class="fa fa-save"></i>
                                    <span class="tooltip-text">
                                        ثبت حقوق
                                    </span>
                                </button>
                                @if (row.Inserted)
                                {
                                    <i class="fa fa-circle-check" style="color: green; background-color: white;"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-circle-xmark text-danger"></i>
                                }

                        
                            </td>

                            break;
                        case "CheckOk":
                            <td>
                                @* payroll ok     *@

                                <button type="button" class="btn  btn-warning tooltip-btn" onclick=" confirmPayroll(@row.PersonnelId, '@ym', '@row.Confirmed', '@row.Vouchered');">
                                    <i class="fa fa-clipboard-check"> </i>
                                    <span class="tooltip-text">
                                        تایید حقوق
                                    </span>
                                </button>
                                @if (row.Confirmed)
                                {
                                    <i class="fa fa-circle-check" style="color: green; background-color: white;"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-circle-xmark text-danger"></i>
                                }
                            </td>
                            <td>
                                @* payroll bill   *@

                                @if (row.Status == AppUtil.enumAttendanceWorkStatus.PayrollConfirmed)
                                {

                                    <button type="button" class="btn  btn-info tooltip-btn"
                                            onclick="window.open('/payroll/SalaryPdf?layout=payslip&id=@row.PersonnelId&ym=@ym', '_blank')">
                                        <i class="fa fa-print"></i>
                                    </button>
                                }
                            </td>
                            break;
                        case "CheckAcc":
                            <td>
                                @* preview        *@
                                <button type="button" class="btn  btn-success" onclick="PayrollProc(@row.PersonnelId);">
                                    <i class="fa fa-calculator"></i>

                                </button>
                            </td>
                            @* payroll acc    *@
                            @* <td>
                                <button type="button" class="btn  btn-warning tooltip-btn" onclick=" VoucherPayroll(@row.PersonnelId, '@ym', '@row.Confirmed', '@row.Vouchered');">
                                    <i class="fa fa-bank"></i>
                                </button>
                                @if (row.Vouchered)
                                {
                                    <i class="fa fa-circle-check" style="color: green; background-color: white;"></i>
                                }
                                else
                                {

                                    <i class="fa-solid fa-circle-xmark text-danger"></i>
                                }
                            </td> *@
                            break;
                        default:
                            break;
                    }

                </tr>
            }

        </tbody>

    </table>

</div>

<script src="~/js/attendancecheckresult.js"></script>