@using static AttendanceCheckViewModel
@model CalculateViewModel

<div class="table-responsive">

    <table class="table table-bordered table-hover align-middle">

        <thead class="table-light">

            <tr>

               
                <th>پرسنل</th>

                <th style="width:300px;">عملیات</th>

               

            </tr>

        </thead>

        <tbody>

            @foreach (AttendanceCheckViewModel row in Model.Check)
            {

                var errClass = "";
                if (row.Status == AttendanceWorkStatus.Incorrect || row.Status == AttendanceWorkStatus.Incomplete)
                { errClass = "table-danger"; }

                <tr class="@errClass">

                    <td>
                        @row.PersonnelName
                    </td>

                    <td class="text-center">

                        @if (row.Status == AttendanceWorkStatus.Incorrect)
                        {
                            <button type="button" class="btn btn-danger" onclick="buttonProc(@row.PersonnelId, '@row.IsCorrectErrText', '@row.hasWorkedErrText');">
                                <i class="fa fa-times-circle"></i>
                                کارکرد نادرست
                            </button>
                        }
                        else if (row.Status == AttendanceWorkStatus.Incomplete)
                        {
                            <button type="button" class="btn btn-danger" onclick="buttonProc(@row.PersonnelId, '@row.IsCorrectErrText', '@row.hasWorkedErrText');">
                                <i class="fa fa-times-circle"></i>
                                کارکرد ناقص
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-primary" onclick="buttonProc(@row.PersonnelId, '@row.IsCorrectErrText', '@row.hasWorkedErrText');">

                                <i class="fa fa-check-circle"></i>
                                کارکرد صحیح
                            </button>
                            <button type="button" class="btn  btn-success" onclick="PayrollProc(@row.PersonnelId);">
                                <i class="fa fa-exclamation-triangle"></i>
                                محاسبه
                            </button>
                        }

                    </td>

                     
                </tr>
            }

        </tbody>

    </table>

</div>

<script>
  
    function PayrollProc(personnelId) {
        const select = document.querySelector('select[name="year"]');
        const year = select.options[select.selectedIndex].text;

        var month = $("#attendanceMonth").val();

        $.ajax({
            type: "GET",
            url: "/Payroll/PayrollPreview",
            data:
            {
                year: year,
                month: month,
                personnelId: personnelId 
            },

            success: function(data) {

              
                $("#attendanceCheckModalContent")
                    .html(data);

 

                $("#attendanceCheckModal")
                    .modal("show");
            }

        });
    }

    function buttonProc(personnelId, correctErrText, hasWorkedText) {

         
        const select = document.querySelector('select[name="year"]');
        const year = select.options[select.selectedIndex].text;

        var month = $("#attendanceMonth").val();

        
        $.ajax({

            url: "/Attendance/List",

            data:
            {
                year: year,
                month: month,
                personnelId: personnelId,
                CorrectErrText: correctErrText,
                HasWorkedText: hasWorkedText
            },

            success: function(data) {

              
                $("#attendanceCheckModalContent")
                    .html(data);


                // $.validator.unobtrusive.parse(
                //     "#personnelOrderForm"
                // );

                // initContractSelect2();
                // initContractDatePickers();
                //initPersonnelOrderForm();

                $("#attendanceCheckModal")
                    .modal("show");
            }

        });

    }
</script>