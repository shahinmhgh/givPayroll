@using static AttendanceCheckViewModel
@model CalculateViewModel

<div class="table-responsive">

    <table class="table table-bordered table-hover align-middle">

        <thead class="table-light">

            <tr>

               
                <th>پرسنل</th>

                <th style="width:200px;">عملیات</th>

               

            </tr>

        </thead>

        <tbody>

            @foreach (AttendanceCheckViewModel row in Model.Check)
            {
                var total = row.Work
                           + row.Leave
                           + row.LeaveSickMinute
                           + row.LeaveNormalMinute
                           + row.LeaveWithoutSalary
                           + row.Absence
                           + row.Mission;

                var shortage = Math.Max(
                    row.Required - total,
                    0
                );

                <tr class="@(row.Status == AttendanceWorkStatus.Incorrect ? "" : "table-danger")">

                    <td>
                        @row.PersonnelName
                    </td>

                    <td class="text-center">

                        @if (row.Status == AttendanceWorkStatus.Incorrect)
                        {
                            <button type="button" class="btn btn-danger" onclick="buttonProc(@row.PersonnelId);">

                                <i class="fa fa-times-circle"></i>
                                کارکرد نادرست
                            </button>
                        }
                        else if (row.Status == AttendanceWorkStatus.Incomplete)
                        {
                            <button type="button" class="btn btn-danger" onclick="buttonProc();">

                                <i class="fa fa-times-circle"></i>
                                کارکرد ناقص
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn  btn-success" onclick="buttonProc();">

                                <i class="fa fa-exclamation-triangle"></i>
                                محاسبه حقوق
                            </button>
                        }

                    </td>

                     
                </tr>
            }

        </tbody>

    </table>

</div>

<script>
    function buttonProc(personnelId) {
        const select = document.querySelector('select[name="year"]');
        const year = select.options[select.selectedIndex].text;

        var month = $("#attendanceMonth").val();
        

        $.ajax({

            url: "/Attendance/List",

            data:
            {
                year: year,
                month: month,
                personnelId: personnelId
            },

            success: function(data) {
              

                $("#attendanceCheckModalContent")
                    .html(data);


                // $.validator.unobtrusive.parse(
                //     "#personnelOrderForm"
                // );

                // initContractSelect2();
                // initContractDatePickers();
                //initPersonnelOrderForm();

                $("#attendanceCheckModal")
                    .modal("show");
            }

        });

    }
</script>