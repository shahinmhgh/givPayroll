@using static AttendanceCheckViewModel
@model CalculateViewModel

<div class="table-responsive" >

    <table class="table table-bordered table-hover align-middle">

        <thead class="table-light">

            <tr>

               
                <th>پرسنل</th>

                <th style="width:300px;">عملیات</th>

               

            </tr>

        </thead>

        <tbody>

            @foreach (AttendanceCheckViewModel row in Model.Check)
            {

                var errClass = "";
                if (row.Status == AttendanceWorkStatus.Incorrect || row.Status == AttendanceWorkStatus.Incomplete)
                { errClass = "table-danger"; }

                <tr class="@errClass">

                    <td>
                        @row.PersonnelName
                    </td>

                    <td class="text-center">

                        @if (row.Status == AttendanceWorkStatus.Incorrect)
                        {
                            <button type="button" class="btn btn-danger" onclick="buttonProc(@row.PersonnelId, '@row.IsCorrectErrText', '@row.hasWorkedErrText');">
                                <i class="fa fa-times-circle"></i>
                                کارکرد نادرست
                            </button>
                        }
                        else if (row.Status == AttendanceWorkStatus.Incomplete)
                        {
                            <button type="button" class="btn btn-danger" onclick="buttonProc(@row.PersonnelId, '@row.IsCorrectErrText', '@row.hasWorkedErrText');">
                                <i class="fa fa-times-circle"></i>
                                کارکرد ناقص
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-primary" onclick="buttonProc(@row.PersonnelId, '@row.IsCorrectErrText', '@row.hasWorkedErrText');">

                                <i class="fa fa-check-circle"></i>
                                کارکرد صحیح
                            </button>
                            <button type="button" class="btn  btn-success" onclick="PayrollProc(@row.PersonnelId);">
                                <i class="fa fa-exclamation-triangle"></i>
                                محاسبه
                            </button>
                        }

                    </td>

                     
                </tr>
            }

        </tbody>

    </table>

</div>

<script src="~/js/attendancecheckresult.js"></script>