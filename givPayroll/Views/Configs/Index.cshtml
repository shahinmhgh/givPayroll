@model List<Config>

@{
    ViewData["Title"] = "شرکت";
}

<div class="container mt-4">
    <h3>اطلاعات شرکت</h3>

    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>کد</th>
                <th>نام شرکت</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="2" class="text-center">
                        No companies found.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var config in Model)
                {
                    <tr>
                        <td>@config.CompanyID</td>
                        <td>@config.CompanyName</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>