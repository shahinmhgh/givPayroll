@model List<givPayroll.Models.Holiday>

@{
    ViewData["Title"] = "تعطیلات";
    int year = ViewBag.Year;
}

<link rel="stylesheet" href="~/pages/css/table.css" />

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h3>
            تعطیلات سال @year
        </h3>

        <div class="d-flex gap-2">

            <select id="year"
                    class="form-select"
                    style="width:120px;"
                    onchange="changeYear()">

                @for (int y = 1400; y <= 1410; y++)
                {
                    if (y == year)
                    {
                        <option value="@y" selected>
                            @y
                        </option>
                    }
                    else
                    {
                        <option value="@y">
                            @y
                        </option>
                    }
                }

            </select>

            <button type="button"
                    class="btn btn-primary"
                    onclick="openCreate()">

                <i class="bi bi-plus"></i>
                تعطیلی جدید

            </button>

        </div>

    </div>


    <div class="card">

        <div class="card-body p-0">

            <table class="table table-hover table-bordered mb-0">

                <thead>

                    <tr>

                        <th style="width:60px;">
                            #
                        </th>

                        <th>
                            تاریخ
                        </th>

                        <th>
                            روز
                        </th>

                        <th>
                            عنوان
                        </th>

                        <th>
                            نوع
                        </th>

                        <th>
                            توضیحات
                        </th>

                        <th style="width:150px;">
                            عملیات
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @{
                        int row = 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @row
                            </td>

                            <td>
                                @{
                                    var pc = new System.Globalization.PersianCalendar();

                                    string persianDate =
                                        $"{pc.GetYear(item.Date):0000}/" +
                                        $"{pc.GetMonth(item.Date):00}/" +
                                        $"{pc.GetDayOfMonth(item.Date):00}";
                                }

                                @persianDate
                            </td>

                            <td>
                                @item.Date.ToString("dddd",
                                    new System.Globalization.CultureInfo("fa-IR"))
                            </td>

                            <td>
                                @item.Title
                            </td>

                            <td>

                                @if (item.IsOfficial)
                                {
                                    <span class="badge bg-danger">
                                        رسمی
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        سازمانی
                                    </span>
                                }

                            </td>

                            <td>
                                @item.Description
                            </td>

                            <td>

                                <button class="btn btn-sm btn-warning"
                                        onclick="openEdit(@item.Id)">

                                    ویرایش

                                </button>

                                <button class="btn btn-sm btn-danger"
                                        onclick="deleteHoliday(@item.Id)">

                                    حذف

                                </button>

                            </td>

                        </tr>

                        row++;
                    }

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center p-4">

                                برای سال @year تعطیلی ثبت نشده است.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- Modal -->

<div class="modal fade"
     id="holidayModal"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="holidayModalTitle">

                    تعطیلی

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body"
                 id="holidayModalBody">
            </div>

        </div>

    </div>

</div>


@Html.AntiForgeryToken()


@section Scripts {

    <script>

        function changeYear() {

            const year = $('#year').val();

            window.location.href =
                '@Url.Action("Index", "Holiday")' +
                '?year=' + year;
        }


        function openCreate() {

            const year = $('#year').val();

            $.get(
                '@Url.Action("Create", "Holiday")',
                { year: year },
                function(html) {

                    $('#holidayModalTitle').text('ثبت تعطیلی');

                    $('#holidayModalBody').html(html);

                    $('#holidayModal').modal('show');

                }
            );
        }


        function openEdit(id) {

            $.get(
                '@Url.Action("Edit", "Holiday")',
                { id: id },
                function(html) {

                    $('#holidayModalTitle').text('ویرایش تعطیلی');

                    $('#holidayModalBody').html(html);

                    $('#holidayModal').modal('show');

                }
            );
        }


        function saveHoliday() {

            const form = $('#holidayForm');

            $.ajax({

                url: form.attr('action'),

                type: 'POST',

                data: form.serialize(),

                success: function(response) {

                    if (response.success) {

                        $('#holidayModal').modal('hide');

                        location.reload();

                    }
                    else {

                        $('#holidayModalBody').html(response);

                    }

                },

                error: function() {

                    alert('خطا در ذخیره اطلاعات');

                }

            });
        }


        function deleteHoliday(id) {

            if (!confirm('آیا از حذف این تعطیلی مطمئن هستید؟'))
                return;

            const token =
                $('input[name="__RequestVerificationToken"]').val();

            $.ajax({

                url: '@Url.Action("Delete", "Holiday")',

                type: 'POST',

                data: {
                    id: id,
                    __RequestVerificationToken: token
                },

                success: function(response) {

                    if (response.success) {

                        location.reload();

                    }
                    else {

                        alert(response.message);

                    }

                }

            });

        }

    </script>

}