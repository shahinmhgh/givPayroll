    }
    .editable {
        cursor: text;
    }
    .editable:focus {
        outline: 2px solid #777;
        background: #eee;
    }
    @@media print {
        body { padding: 0; }
        .pay-slip { width: 100%; }
        @@page {
            size: A4 landscape;
            margin: 10mm;
        }
    }
</style>
 
 

