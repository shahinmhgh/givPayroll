@using givPayroll.Services
@model givPayroll.Models.SalaryReportViewModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="fa" dir="rtl">

<head>

    <meta charset="utf-8" />

    <title>فیش حقوقی</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />

    <style>

        @@page {
            size: A4;
            margin: 10mm;
        }

        html,
        body {
            direction: rtl;
            font-family: Shabnam;
            font-size: 13px;
            background: white;
            color: #000;
        }

        body {
            margin: 0;
        }

        .report {
            width: 100%;
        }

        .report-header {
            text-align: center;
            margin-bottom: 20px;
        }

        .report-header h2 {
            font-size: 22px;
            margin-bottom: 5px;
        }

        .employee-info {
            border: 1px solid #000;
            padding: 10px;
            margin-bottom: 15px;
        }

        .employee-info table {
            margin-bottom: 0;
        }

        .salary-table {
            width: 100%;
            border-collapse: collapse;
        }

        .salary-table th,
        .salary-table td {
            border: 1px solid #000;
            padding: 8px;
            text-align: right;
        }

        .salary-table th {
            background-color: #eeeeee;
            font-weight: bold;
        }

        .total {
            font-weight: bold;
            font-size: 16px;
        }

        .footer {
            margin-top: 30px;
            text-align: center;
            font-size: 11px;
        }

        .page-break {
            page-break-before: always;
        }

        table {
            page-break-inside: avoid;
        }

        tr {
            page-break-inside: avoid;
        }

        .no-print {
            display: none !important;
        }

    </style>

</head>

<body>

<div class="report">

    <div class="report-header">

        <h2>فیش حقوقی</h2>

        <div>
            ماه @Model.PayrollMonth
        </div>

    </div>


    <div class="employee-info">

        <table class="table table-borderless">

            <tr>

                <td>
                    <strong>کد پرسنلی:</strong>
                        @Model.PersonnelCode.ToPersianDigits()
                </td>

                <td>
                    <strong>نام:</strong>
                    @Model.FirstName
                </td>

                <td>
                    <strong>نام خانوادگی:</strong>
                    @Model.LastName
                </td>

            </tr>

            <tr>

                <td colspan="3">

                    <strong>کد ملی:</strong>
                        <label style="font-family: Shabnam">@Model.NationalCode.ToPersianDigits()</label>

                </td>

            </tr>

        </table>

    </div>


    <table class="salary-table">

        <thead>

            <tr>

                <th>شرح</th>

                <th>مبلغ</th>

            </tr>

        </thead>

        <tbody>

            <tr>
                <td>حقوق پایه</td>
                <td>
                    @* @Model.BasicSalary.ToString("N0") *@
                    @Model.BasicSalary.ToString("N0").ToPersianDigits()
                </td>
            </tr>

            <tr>
                <td>حق مسکن</td>
                <td>
                        @Model.HousingAllowance.ToString("N0").ToPersianDigits()
                </td>
            </tr>

            <tr>
                <td>بن / کمک هزینه غذا</td>
                <td>
                        @Model.FoodAllowance.ToString("N0").ToPersianDigits()
                </td>
            </tr>

            <tr>
                <td>اضافه کاری</td>
                <td>
                        @Model.Overtime.ToString("N0").ToPersianDigits()
                </td>
            </tr>

            <tr>
                <td>کسورات</td>
                <td>
                        @Model.Deductions.ToString("N0").ToPersianDigits()
                </td>
            </tr>

            <tr class="total">

                <td>
                    خالص پرداختی
                </td>

                <td>
                        @Model.NetSalary.ToString("N0").ToPersianDigits()
                </td>

            </tr>

        </tbody>

    </table>


    <div class="footer">

        این گزارش به صورت الکترونیکی تولید شده است.

    </div>

</div>

</body>

</html>