@using givPayroll.Services
@* @model givPayroll.Models.SalaryReportViewModel *@
@model PayrollViewModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="fa" dir="rtl">

<head>

    <meta charset="utf-8" />

    <title>فیش حقوقی</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />

    
    <style>

            @@page {
                size: A4;
                margin: 10mm;
            }

            html,
            body {
                direction: rtl;
                font-family: Shabnam;
                font-size: 13px;
                background: white;
                color: #000;
            }

            body {
                margin: 0;
            }

            .report {
                width: 100%;
            }

            .report-header {
                text-align: center;
                margin-bottom: 20px;
            }

                .report-header h2 {
                    font-size: 22px;
                    margin-bottom: 5px;
                }

            .employee-info {
                border: 1px solid #000;
                padding: 10px;
                margin-bottom: 15px;
            }

                .employee-info table {
                    margin-bottom: 0;
                }

            .salary-table {
                width: 100%;
                border-collapse: collapse;
            }

                .salary-table th,
                .salary-table td {
                    border: 1px solid #000;
                    padding: 8px;
                    text-align: right;
                }

                .salary-table th {
                    background-color: #eeeeee;
                    font-weight: bold;
                }

                .salary-table tr {
                    height: 25px !important;
                }

                .salary-table td {
                    padding: 3px 8px !important;
                    /* line-height: 1.1 !important; */
                    height: 25px !important;
                    vertical-align: middle;
                }


            .total {
                font-weight: bold;
                font-size: 16px;
            }

            .footer {
                margin-top: 30px;
                text-align: center;
                font-size: 11px;
            }

            .page-break {
                page-break-before: always;
            }

            table {
                page-break-inside: avoid;
            }

            tr {
                page-break-inside: avoid;
                height: 25px !important;
            }

            .no-print {
                display: none !important;
            }

    </style>

</head>

<body>

    <div class="report">

        <div class="report-header">

            <h2>فیش حقوقی</h2>

            <div>
                @ViewBag.YearMonthName
            </div>

        </div>


        <div class="employee-info">

            <table class="table table-borderless payroll-table">

                <tr>

                    @*   <td>
                    <strong>کد پرسنلی:</strong>
                        @Model.PersonnelCode.ToPersianDigits()
                </td> *@

                    <td>
                        <strong>نام:</strong>
                        @Model.Personnel.FirstName
                    </td>

                    <td>
                        <strong>نام خانوادگی:</strong>
                        @Model.Personnel.LastName
                    </td>

                </tr>

                <tr>

                    @*   <td colspan="3">

                    <strong>کد ملی:</strong>
                        <label style="font-family: Shabnam">@Model.NationalCode.ToPersianDigits()</label>

                </td> *@

                </tr>

            </table>

        </div>


        <table class="salary-table">

            <thead>

                <tr>

                    <th>شرح</th>

                    <th>مبلغ</th>

                </tr>

            </thead>

            <tbody>
                @{
                    decimal total = 0;

                    foreach (PayrollItem item in Model.PayrollItems)
                    {
                        var amount = item.Amount;

                        if (item.SalaryItem.PlusMinus == 1)
                            total += amount;
                        else
                            total -= amount;
                        <tr>
                            <td>
                                @{
                                    var desc = @item.SalaryItem.SalaryItemName;
                                    if (!string.IsNullOrEmpty(@item.Description))
                                    { desc += " - " + @item.Description; }
                                }
                                @desc
                            </td>
                            <td>
                                @item.Amount.ToString("N0").ToPersianDigits()
                            </td>
                        </tr>
                    }
                }
                <tr>

                    <th>جمع</th>

                    <th>@total.ToString("N0").ToPersianDigits()</th>

                </tr>
            </tbody>

        </table>


        <div class="footer">

            این گزارش به صورت الکترونیکی تولید شده است.

        </div>

    </div>

 
 
<title>فیش حقوقی کارکنان شرکت کشواد رایان افزار</title>
