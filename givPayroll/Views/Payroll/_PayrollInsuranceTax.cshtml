@using givPayroll.Models.DTO
@model List<InsuTaxViewModel>
<!-- ================================================= -->
<!-- HEADER -->
<!-- ================================================= -->

<style>
    .payroll-table-container {
        height: 500px;
        overflow-y: auto;
    }

    .payroll-table tbody tr {
        height: 25px !important;
    }

    .payroll-table tbody td {
        padding: 3px 8px !important;
        /* line-height: 1.1 !important; */
        height: 25px !important;
        vertical-align: middle;
    }
</style>

<div class="modal-header">

    <h5 class="modal-title">

        پیش نمایش

    </h5>

    <button type="button"
            class="btn-close"
            data-bs-dismiss="modal">
    </button>

</div>


<div class="modal-body">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>


    <!-- ================================================= -->
    <!-- PERSONNEL ORDER -->
    <!-- ================================================= -->

    <div class="card mb-3">

        <div class="card-header">

            <strong>
                @ViewBag.Title
            </strong>

        </div>

    </div>
    @{
        var insuranceTax = @ViewBag.insuranceTax;
    }

    <!-- ================================================= -->
    <!-- DETAILS -->
    <!-- ================================================= -->

    <div class="card">

        @*     <div class="card-header d-flex
            justify-content-between
            align-items-center">

            <strong>
                اقلام حقوق دستمزد
            </strong>
        </div>
 *@
        <div class="card-body p-0">

            <div class="table-responsive payroll-table-container">

                <table class="table
                    table-bordered
                    table-hover
                    payroll-table">

                    <thead>

                        <tr class="table-secondary">

                            <th style="width:80px">
                                ردیف

                            </th>

                            <th style="width:180px!important;background-color:whitesmoke;">
                                قلم حقوق
                            </th>

                            <th style="width:50px">

                            </th>

                            <th style="width:200px">
                                مبلغ
                            </th>
                            @if (@insuranceTax == 1)
                            {
                                <th style="width:200px">
                                    مبلغ محاسبه
                                </th>
                            }

                        </tr>

                    </thead>


                    <tbody>
                        @{
                            var row = 1;
                            var Zero = 0;
                            decimal totalAfter = 0; decimal total = 0;
                            foreach (InsuTaxViewModel item in Model)
                            {
                                var amount = item.Amount;
                                var amountAfter = item.AmountAfter;
                                int PlusMinus = item.PlusMinus;
                                //if (item.SalaryItem.PlusMinus == 1)
                                if (@insuranceTax == 1)
                                {
                                    totalAfter += amountAfter * item.SalaryItem.PlusMinus;
                                    total += amount * item.SalaryItem.PlusMinus;
                                }
                                if (@insuranceTax == 2)
                                {
                                    total += amount * item.SalaryItem.PlusMinus;
                                    totalAfter += amountAfter;
                                }
                                //else
                                //   total -= amount;

                            
                                <tr style="height:25px!important;">
                                    <td style="width:80px">
                                        @row

                                    </td>

                                    <td style="width:180px!important;background-color:whitesmoke;">
                                        @{
                                            var desc = @item.SalaryItem.SalaryItemName;
                                            if (!string.IsNullOrEmpty(@item.Description))
                                            { desc += " - " + @item.Description; }
                                        }
                                        @desc
                                    </td>

                                    <td style="width:50px;">
                                        @if (@item.PlusMinus == 1)
                                        {
                                            <span class="badge bg-success" style="width:25px;">
                                                +
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger" style="width:25px;">
                                                -
                                            </span>
                                        }
                                    </td>
                                    <td style="width:200px;">
                                        @item.Amount.ToString("N0")
                                    </td>
                                    @if (@insuranceTax == 1)
                                    {
                                        <td style="width:200px;">
                                            @item.AmountAfter.ToString("N0")
                                        </td>
                                    }
                                </tr>
                                row++;
                            }
                        }
                        @if (@insuranceTax == 1)
                        {
                            <tr class="table-secondary fw-bold" style="height:25px!important;">
                                <td colspan="3" class="text-end">
                                    جمع
                                </td>
                                <td style="width:200px">
                                    @total.ToString("N0")
                                </td>
                                <td style="width:200px">
                                    @totalAfter.ToString("N0")
                                </td>
                            </tr>
                        }
                        @if (@insuranceTax == 2)
                        {
                            <tr class="table-secondary fw-bold" style="height: 25px!important; line-height: 25px!important;">
                                <td colspan="3" class="text-end">
                                    جمع
                                </td>
                                <td style="width:200px">
                                    @total.ToString("N0")
                                </td>

                            </tr>

                            List<CalculateTaxDetail> TaxDetail = (List<CalculateTaxDetail>)ViewBag.TaxDetail;
                            decimal totAmount = TaxDetail.Sum(x => x.Amount);
                            @foreach (var item in TaxDetail)
                            {
                                <tr class="table-secondary fw-bold" style="height:25px!important;">
                                    <td colspan="3" class="text-end">
                                        @item.Title
                                    </td>
                                    <td class="payroll-table">
                                        @item.Amount.ToString("N0")
                                    </td>
                                </tr>
                            }
                            <tr class="table-secondary fw-bold" style="height:25px!important;">
                                <td colspan="3" class="text-end">
                                    جمع مالیات
                                </td>
                                <td class="payroll-table">
                                    @totAmount.ToString("N0")
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        
                    </tfoot>
                </table>

            </div>
            @* end *@
        </div>

    </div>

</div>


<!-- ================================================= -->
<!-- FOOTER -->
<!-- ================================================= -->

<div class="modal-footer">

    

    <button type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal">

        خروج

    </button>

 

</div>

 