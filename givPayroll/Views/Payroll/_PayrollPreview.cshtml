@model PayrollViewModel
<!-- ================================================= -->
<!-- HEADER -->
<!-- ================================================= -->

<style>
    .payroll-table-container {
        height: 500px;
        overflow-y: auto;
    }

    .payroll-table tbody tr {
        height: 25px !important;
    }

    .payroll-table tbody td {
        padding: 3px 8px !important;
        /* line-height: 1.1 !important; */
        height: 25px !important;
        vertical-align: middle;
    }
</style>

<div class="modal-header">

    <h5 class="modal-title">

        پیش نمایش حقوق

    </h5>


    <button type="button"
            class="btn-close"
            data-bs-dismiss="modal">
    </button>

</div>


<div class="modal-body">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>


    <!-- ================================================= -->
    <!-- PERSONNEL ORDER -->
    <!-- ================================================= -->

    <div class="card mb-3">

        <div class="card-header">

            <strong>
                @ViewBag.PersonnelYearMonthName
            </strong>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- DETAILS -->
    <!-- ================================================= -->

    <div class="card">

        @*     <div class="card-header d-flex
            justify-content-between
            align-items-center">

            <strong>
                اقلام حقوق دستمزد
            </strong>
        </div>
 *@
        <div class="card-body p-0">

            <div class="table-responsive payroll-table-container">

                <table class="table
                    table-bordered
                    table-hover
                    payroll-table">

                    <thead>

                        <tr class="table-secondary">

                            <th style="width:80px">
                                ردیف

                            </th>

                            <th>
                                قلم حقوق
                            </th>


                            <th style="width:50px">

                            </th>
                            <th style="width:250px">
                                مبلغ
                            </th>

                        </tr>

                    </thead>


                    <tbody>
                        @{
                            var row = 1;
                            decimal total = 0;
                            foreach (PayrollItem item in Model.PayrollItems)
                            {
                                var amount = item.Amount;

                                if (item.SalaryItem.PlusMinus == 1)
                                    total += amount;
                                else
                                    total -= amount;

                            
                                <tr style="height:25px!important;">
                                    <td style="width:80px">
                                        @row
                                        @{
                                            var desc1 = @item.SalaryItem.Label;
                                            if (desc1=="Insurance" || desc1=="Tax")
                                            {
                                                <button type="button" class="btn btn-sm btn-primary">...</button>
                                            }
                                        }
                                    </td>

                                    <td>
                                        @{
                                            var desc = @item.SalaryItem.SalaryItemName;
                                            if (!string.IsNullOrEmpty(@item.Description))
                                            { desc += " - " + @item.Description; }
                                        }
                                        @desc
                                    </td>
                                    <td class="text-center">

                                        @if (@item.SalaryItem.PlusMinus == 1)
                                        {
                                            <span class="badge bg-success">
                                                +
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                -
                                            </span>
                                        }

                                    </td>
                                    <td style="width:250px">
                                        @item.Amount.ToString("N0")
                                    </td>
                                </tr>
                                row++;
                            }
                        }

                    </tbody>
                    <tfoot>
                        <tr class="table-secondary fw-bold">
                            <td colspan="3" class="text-end">
                                جمع
                            </td>
                            <td style="width:250px">
                                @total.ToString("N0")
                            </td>
                        </tr>
                    </tfoot>
                </table>

            </div>
            @* end *@
        </div>

    </div>

</div>


<!-- ================================================= -->
<!-- FOOTER -->
<!-- ================================================= -->

<div class="modal-footer">
    <button type="button" style="fa fa-print" onclick="window.open('/payroll/SalaryPdf?id=@Model.PersonnelId&ym=1405/05', '_blank')"
            class="btn btn-primary">

            
        چاپ

    </button>


    <button type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal">

        خروج

    </button>

 

</div>

 