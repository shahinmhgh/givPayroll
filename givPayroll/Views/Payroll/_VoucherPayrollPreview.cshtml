@model List<givPayroll.Models.VoucherModel>

@{
    var totalDebit = Model?.Sum(x => x.Debit ?? 0) ?? 0;
    var totalCredit = Model?.Sum(x => x.Credit ?? 0) ?? 0;
    var difference = totalDebit - totalCredit;

    var first = Model?.FirstOrDefault();
}

<div class="voucher-preview" dir="rtl">

    <!-- Header -->
    <div class="modal-header bg-primary text-white">

        <div>
            <h5 class="modal-title mb-1">
                <i class="fa fa-file-invoice-dollar ms-2"></i>
                پیش‌نمایش سند حسابداری حقوق و دستمزد
            </h5>

            @if (first != null)
            {
                <small>
                    دوره حقوق:
                    @first.PayrollYear /
                    @first.PayrollMonth.ToString("00")
                </small>
            }
        </div>

        <button type="button"
                class="btn-close btn-close-white"
                data-bs-dismiss="modal">
        </button>

    </div>

    <!-- Body -->
    <div class="modal-body">

        <!-- Summary -->
        <div class="row g-3 mb-3">

            <div class="col-md-4">
                <div class="border rounded p-3 bg-light">
                    <small class="text-muted">تعداد ردیف‌ها</small>
                    <h5 class="mb-0 mt-1">
                        @(Model?.Count ?? 0)
                    </h5>
                </div>
            </div>

            <div class="col-md-4">
                <div class="border rounded p-3 bg-light">
                    <small class="text-muted">جمع بدهکار</small>
                    <h5 class="mb-0 mt-1 text-danger">
                        @totalDebit.ToString("#,##0.###")
                    </h5>
                </div>
            </div>

            <div class="col-md-4">
                <div class="border rounded p-3 bg-light">
                    <small class="text-muted">جمع بستانکار</small>
                    <h5 class="mb-0 mt-1 text-success">
                        @totalCredit.ToString("#,##0.###")
                    </h5>
                </div>
            </div>

        </div>

        <!-- Voucher Details -->
        <div class="table-responsive" style="max-height: 420px;">

            <table class="table table-bordered table-hover table-striped align-middle text-center mb-0">

                <thead class="table-dark sticky-top">
                    <tr>
                        <th style="width:50px">ردیف</th>
                        <th>کد معین</th>
                        <th>کد تفصیلی</th>
                        <th>شرح حساب</th>
                        <th>کد آیتم</th>
                        <th>پروژه</th>
                        <th>بدهکار</th>
                        <th>بستانکار</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        var index = 1;

                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@index</td>

                                <td>
                                    @(item.PersonCategoryCode ?? "-")
                                </td>

                                <td>
                                    @(item.PersonID?.ToString() ?? "-")
                                </td>

                                <td class="text-start">
                                    @item.SalaryItemName
                                </td>

                                <td>@item.SalaryItemId</td>

                                <td>
                                    @(item.ProjectId?.ToString() ?? "-")
                                </td>

                                <td class="text-end text-danger fw-bold">
                                    @(item.Debit?.ToString("#,##0.###") ?? "-")
                                </td>

                                <td class="text-end text-success fw-bold">
                                    @(item.Credit?.ToString("#,##0.###") ?? "-")
                                </td>
                            </tr>

                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted p-4">
                                اطلاعاتی برای نمایش وجود ندارد
                            </td>
                        </tr>
                    }

                </tbody>

                <tfoot class="table-secondary fw-bold">

                    <tr>
                        <td colspan="6" class="text-end">
                            جمع کل
                        </td>

                        <td class="text-end text-danger">
                            @totalDebit.ToString("#,##0.###")
                        </td>

                        <td class="text-end text-success">
                            @totalCredit.ToString("#,##0.###")
                        </td>
                    </tr>

                </tfoot>

            </table>

        </div>

        <!-- Balance Status -->
        <div class="mt-3 p-3 rounded border
            @(difference == 0 ? "bg-success-subtle border-success" : "bg-danger-subtle border-danger")">

            <div class="d-flex justify-content-between align-items-center">

                <strong>
                    <i class="fa @(difference == 0 ? "fa-check-circle text-success" : "fa-exclamation-triangle text-danger") ms-1"></i>
                    وضعیت تراز سند
                </strong>

                <strong class="@(difference == 0 ? "text-success" : "text-danger")">
                    @(difference == 0 ? "سند تراز است" : "سند تراز نیست")
                </strong>

            </div>

            @if (difference != 0)
            {
                <small class="text-danger mt-2 d-block">
                    اختلاف بدهکار و بستانکار:
                    @Math.Abs(difference).ToString("#,##0.###")
                </small>
            }

        </div>

    </div>

    <!-- Footer -->
    <div class="modal-footer bg-light d-flex justify-content-between">

        <div class="text-muted small">
            <i class="fa fa-info-circle ms-1"></i>
            لطفاً اطلاعات سند را قبل از ثبت بررسی کنید.
        </div>

        <div class="d-flex gap-2">

            <button type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">

                <i class="fa fa-times ms-1"></i>
                انصراف

            </button>

            <button type="button"
                    class="btn btn-success"
                    onclick="saveVoucherPayroll(this)"
                @(Model == null || !Model.Any() || difference != 0 ? "disabled" : "")>

                <i class="fa fa-save ms-1"></i>
                ثبت سند حسابداری

            </button>

        </div>

    </div>

</div>