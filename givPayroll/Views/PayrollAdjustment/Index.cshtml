@{
    ViewData["Title"] = "تعدیلات حقوق";
}
<style>
    #payrollAdjustmentPersonnelModal .modal-content {
        background-color: lightgray;
    }

    #payrollAdjustmentPersonnelModal .modal-body {
        background-color: lightgray;
    }

    #payrollAdjustmentPersonnelModal .modal-header,
    #payrollAdjustmentPersonnelModal .modal-footer {
        background-color: lightgray;
    }
</style>
<div class="container-fluid">

    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                تعدیلات حقوق
            </h5>

            <button type="button"
                    class="btn btn-primary"
                    onclick="createPayrollAdjustment()">

                <i class="fa fa-plus"></i>
                تعدیل جدید

            </button>

        </div>

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-4">

                    <input type="text"
                           id="searchDescription"
                           class="form-control"
                           placeholder="جستجوی توضیحات..." />

                </div>

                <div class="col-md-2">

                    <button type="button"
                            class="btn btn-secondary"
                            onclick="loadPayrollAdjustments()">

                        جستجو

                    </button>

                </div>

            </div>

            <div >
                <div id="payrollAdjustmentList">
                </div>
            </div>

        </div>

    </div>

</div>


<!-- Main Modal -->

<div class="modal fade"
     id="payrollAdjustmentModal"
     tabindex="-1">

    <div class="modal-dialog modal-xl">

        <div class="modal-content"
             id="payrollAdjustmentModalContent">
        </div>

    </div>

</div>


<!-- Personnel Modal -->

<div class="modal fade"
     id="payrollAdjustmentPersonnelModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    انتخاب پرسنل
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <input type="text"
                       id="personnelSearch"
                       class="form-control mb-3"
                       placeholder="جستجوی پرسنل..." />

                <div id="availablePersonnelList" style="height:300px;overflow-y:auto;">
                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/payrollAdjustment.js"></script>

    <script>

        $(document).ready(function() {

            loadPayrollAdjustments();

        });

    </script>
}