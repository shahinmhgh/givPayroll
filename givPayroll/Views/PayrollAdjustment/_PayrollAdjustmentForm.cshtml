@using givPayroll.ViewModels
@model PayrollAdjustmentViewModel

<form id="payrollAdjustmentForm">

    @Html.AntiForgeryToken()

    <input type="hidden"
           asp-for="Id" />

    <label id="PersonIDField" hidden>@Model.PersonID</label>

    <div class="modal-header">

        <h5 class="modal-title">

            @(Model.Id == 0
                ? "ثبت تعدیل حقوق"
                : "ویرایش تعدیل حقوق")

        </h5>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal">
        </button>

    </div>


    <div class="modal-body">

        <div class="row">

            <!-- Description -->

            <div class="col-md-6 mb-3">

                <label asp-for="Description"
                       class="form-label">
                </label>

                <input type="text" asp-for="Description"
                       class="form-control">

                
                <span asp-validation-for="Description"
                      class="text-danger">
                </span>

            </div>


            <!-- Adjustment Type -->

            <div class="col-md-6 mb-3">

                <label asp-for="AdjustmentTypeId"
                       class="form-label">
                </label>

                <select asp-for="AdjustmentTypeId"
                        asp-items="Model.AdjustmentTypes"
                        class="form-select">

                    <option value="">
                        انتخاب کنید
                    </option>

                </select>

                <span asp-validation-for="AdjustmentTypeId"
                      class="text-danger">
                </span>

            </div>


            <!-- Start Date -->
            <div class="col-md-4 mb-3">
                <div id="StartDateApp">
                    <label class="form-label">
                        تاریخ شروع
                    </label>
                    <date-picker v-model="persianDate"
                                 format="jYYYY/jMM/jDD"
                                 display-format="jYYYY/jMM/jDD"
                                 color="#0d6efd"
                                 :editable="true"
                                 placeholder="تاریخ شروع">
                    </date-picker>

                    <input type="hidden"
                           name="StartDate" id="StartDate"
                           :value="gregorianDate">

                </div>
            </div>

             
            <!-- Count -->

            <div class="col-md-4 mb-3">

                <label asp-for="AdjustmentCount"
                       class="form-label">
                </label>

                <input asp-for="AdjustmentCount"
                       type="number"
                       min="1"
                       class="form-control"
                       id="adjustmentCount" />

                <span asp-validation-for="AdjustmentCount"
                      class="text-danger">
                </span>

            </div>


            <!-- End Date -->

            <div class="col-md-4 mb-3">
                <div id="EndDateApp">
                    <label class="form-label">
                        تاریخ پایان
                    </label>
                    <date-picker v-model="persianDate"
                                 format="jYYYY/jMM/jDD"
                                 display-format="jYYYY/jMM/jDD"
                                 color="#0d6efd"
                                 :editable="true"
                                 placeholder="تاریخ پایان">
                    </date-picker>

                    <input type="hidden"
                           name="EndDate" id="EndDate"
                           :value="gregorianDate">

                </div>
            </div>


            <!-- Total Amount -->

            <div class="col-md-4  ">

                <label asp-for="TotalAmount"
                       class="form-label">
                </label>

                <input asp-for="
                       TotalAmount"
                       class="form-control amount-input"
                       type="text"
                       dir="ltr"
                       inputmode="numeric"
                       autocomplete="off"
                       value="@Model.TotalAmount.ToString("N0")" />

 
                <span asp-validation-for="TotalAmount"
                      class="text-danger">
                </span>

            </div>
            <div class="col-md-6  ">
                <div class="form-check">

                    <input asp-for="IsTaxBase"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="IsTaxBase"
                           class="form-check-label">

                        مشمول مالیات

                    </label>

                </div>
                <div class="form-check">

                    <input asp-for="IsInsuranceBase"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="IsInsuranceBase"
                           class="form-check-label">

                        مشمول بیمه

                    </label>

                </div>
            </div>

            <!-- Accounting -->
            <div class="row">
                <div class="col-md-2">

                    <label class="form-label"> @Html.DisplayNameFor(m => m.ProjectId) </label>
                    <select asp-for="ProjectId" asp-items="ViewBag.ProjectId" class="form-select">
                        <option value=""> -- پروژه را انتخاب کنید -- </option>
                    </select>

                </div>

                <div class="col-md-6">

                    <label class="form-label"> @Html.DisplayNameFor(m => m.PersonCategoryCode) </label>
                    <select asp-for="PersonCategoryCode" asp-items="ViewBag.PersonCategoryCode" class="form-select">
                        <option value=""> -- کد معین را انتخاب کنید -- </option>
                    </select>


                </div>


                <div class="col-md-4">
                    <label asp-for="PersonID" class="form-label"></label>

                    <select asp-for="PersonID"
                            asp-items="ViewBag.PersonID"
                            class="form-select"
                            id="PersonID">
                        <option value="">-- کد تفصیلی را انتخاب کنید --</option>
                    </select>
                </div>
            </div>

             

            

          

 
            <!-- Loan -->
            @*    <div class="col-md-4 mb-3">

                <div class="form-check mt-4">

                    <input asp-for="Loan"
                           class="form-check-input" />

                    <label asp-for="Loan"
                           class="form-check-label">
                    </label>

                </div>

            </div> *@

        </div>


        <hr />


        <!-- Personnel -->

        <div class="d-flex justify-content-between align-items-center mb-2">

            <h6>
                پرسنل تعدیل
            </h6>

            <button type="button"
                    class="btn btn-success btn-sm"
                    onclick="openPersonnelModal()">

                <i class="fa fa-plus"></i>
                افزودن پرسنل

            </button>

        </div>


        <div style="height:200px;overflow-y:auto;">
            <table class="table table-bordered"
                   id="selectedPersonnelTable">

                <thead>

                    <tr>

                        <th>
                            ردیف
                        </th>

                        <th>
                            پرسنل
                        </th>

                        <th>
                            عملیات
                        </th>

                    </tr>

                </thead>

                <tbody id="selectedPersonnelBody">

                    @for (int i = 0;
                    i < Model.Personnels.Count;
                    i++)
                    {
                        <tr data-personnel-id="@Model.Personnels[i].PersonnelId">

                            <td>
                                @(i + 1)
                            </td>

                            <td>
                                @Model.Personnels[i].PersonnelName
                            </td>

                            <td>

                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        onclick="removeSelectedPersonnel(this)">

                                    حذف

                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        </div>

        <!-- Hidden PersonnelIds -->

        <div id="personnelHiddenInputs">

            @foreach (var personnelId in Model.PersonnelIds)
            {
                <input type="hidden"
                       name="PersonnelIds"
                       value="@personnelId" />
            }

        </div>

    </div>


    <div class="modal-footer">

        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">

            انصراف

        </button>

        <button type="submit"
                class="btn btn-primary">

            ذخیره

        </button>

    </div>

</form>

<script>
    initializePayrollAdjustmentForm();
</script>
<script>
    let contractDatePickers = {};

    

    function initContractDatePickers() {
        $('#PersonCategoryCode').trigger('change');

        initContractDatePicker(
            '@Model.StartDate.ToString("yyyy-MM-dd")',
            '#StartDateApp'
        );

        initContractDatePicker(
            '@Model.EndDate.ToString("yyyy-MM-dd")',
            '#EndDateApp'
        );
    }

    $(document).on('change', '#PersonCategoryCode', function() {

        
        $('#PersonCategoryCode').select2({
            width: '100%',
            dir: 'rtl',
            // placeholder: '-- انتخاب پرسنل --',
            allowClear: false,
            dropdownParent: $('#payrollAdjustmentModal')
        });

        var categoryCode = $(this).val();
        var personDropdown = $('#PersonID');

        // Reset the persons dropdown
        personDropdown.empty();

        personDropdown.append(
            $('<option>', {
                value: '',
                text: '-- کد تفصیلی را انتخاب کنید --'
            })
        );

        // No category selected
        if (!categoryCode) {
            personDropdown.prop('disabled', true);
            return;
        }

        personDropdown.prop('disabled', true);

        $.ajax({
            url: '/SalaryItem/GetPersonsByCategoryCode',
            type: 'GET',
            data: { categoryCode: categoryCode },

            success: function(persons) {

                $.each(persons, function(index, person) {
                    personDropdown.append(
                        $('<option>', {
                            value: person.value,
                            text: person.text
                        })
                    );
                });

                $('#PersonID').select2({
                    width: '100%',
                    dir: 'rtl',
                    // placeholder: '-- انتخاب پرسنل --',
                    allowClear: false,
                    dropdownParent: $('#payrollAdjustmentModal')
                });

                var PersonIDField = $("#PersonIDField")[0].innerText;
                $("#PersonID").val(PersonIDField).trigger('change');

                //$('#PersonIDField').prop('hidden', true);
                personDropdown.prop('disabled', false);
            },

            error: function(xhr) {
                console.error(xhr);

                alert('خطا در دریافت فهرست کدهای تفصیلی');
                personDropdown.prop('disabled', false);
            }
        });
    });

    $(document).ready(function() {
        $('#PersonCategoryCode').trigger('change');
        
        //var personID = '@Model.PersonID';
        //$("#PersonID").val(personID).trigger('change');
        //$("#" + 'PersonID' + " option[value='" + personID + "']").attr("selected", true);
        //$("#PersonID").val('@Model.PersonID').trigger('change');
        //alert('@Model.PersonID');

 

        
    });


    function initContractDatePicker(initialGregorianDate, elementSelector) {

        const element = $(elementSelector);

        // Element does not exist
        if (!element.length) {
            return;
        }

        // Destroy previous Vue instance
        if (contractDatePickers[elementSelector]) {
            contractDatePickers[elementSelector].$destroy();
            contractDatePickers[elementSelector] = null;
        }

        let initialPersianDate = '';

        if (initialGregorianDate) {

            const date = moment(
                initialGregorianDate,
                [
                    "M/D/YYYY h:mm:ss A",
                    "M/D/YYYY HH:mm:ss",
                    "YYYY-MM-DD"
                ],
                true
            );

            if (date.isValid()) {
                initialPersianDate = date.format("jYYYY/jMM/jDD");
            }
        }

        contractDatePickers[elementSelector] = new Vue({

            el: elementSelector,

            data: {
                persianDate: initialPersianDate
            },

            components: {
                DatePicker: VuePersianDatetimePicker
            },

            computed: {

                gregorianDate() {

                    if (!this.persianDate) {
                        return '';
                    }

                    const date = moment(
                        this.persianDate,
                        "jYYYY/jMM/jDD",
                        true
                    );

                    if (!date.isValid()) {
                        return '';
                    }

                    return date.format("YYYY-MM-DD");
                }
            }
        });
    }

    $(document).on(
        'blur',
        '.amount-input',
        function() {

            let value =
                $(this)
                    .val()
                    .replace(/,/g, '');

            if (value !== '' &&
                !isNaN(value)) {

                $(this).val(
                    Number(value)
                        .toLocaleString('en-US')
                );
            }
        });

</script>