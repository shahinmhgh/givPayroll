@model PayrollAdjustmentListResultViewModel
@using System.Globalization

@{
    var persianCalendar = new PersianCalendar();
}

<div class="table-responsive">

    <table class="table table-bordered table-hover">

        <thead>

            <tr>

                <th>شناسه</th>

                <th>توضیحات</th>

                <th>نوع تعدیل</th>

                <th>تاریخ شروع</th>

                <th>تاریخ پایان</th>

                <th>تعداد اقساط</th>

                <th>پرسنل</th>

                <th>مبلغ کل</th>

            @*     <th>وام</th> *@

                <th style="width:150px">
                    عملیات
                </th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model.Items)
            {
                <tr>

                    <td>
                        @item.Id
                    </td>

                    <td>
                        @item.Description
                    </td>

                    <td>
                        @item.AdjustmentTypeName
                    </td>

                    <td>
                        @($"{persianCalendar.GetYear(item.StartDate):0000}/" +
                          $"{persianCalendar.GetMonth(item.StartDate):00}/" +
                          $"{persianCalendar.GetDayOfMonth(item.StartDate):00}")
                    </td>

                    <td>
                        @($"{persianCalendar.GetYear(item.EndDate):0000}/" +
                          $"{persianCalendar.GetMonth(item.EndDate):00}/" +
                          $"{persianCalendar.GetDayOfMonth(item.EndDate):00}")
                    </td>

                    <td>
                        @item.AdjustmentCount
                    </td>

                    <td>
                        @item.PersonnelCount
                    </td>

                    <td>
                        @item.TotalAmount.ToString("N0")
                    </td>

                   @*  <td>

                        @if (item.Loan)
                        {
                            <span class="badge bg-success">
                                بله
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                خیر
                            </span>
                        }

                    </td> *@

                    <td>

                        <button type="button"
                                class="btn btn-sm btn-warning"
                                onclick="editPayrollAdjustment(@item.Id)">

                            <i class="fa fa-edit"></i>

                        </button>

                        <button type="button"
                                class="btn btn-sm btn-danger"
                                onclick="deletePayrollAdjustment(@item.Id)">

                            <i class="fa fa-trash"></i>

                        </button>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>