
@model  PersonDropdownViewModel

@{
    ViewData["Title"] = "Person Group Lookup";
}

<div class="container mt-4">
    <h4>Person Group Lookup</h4>

    <form asp-action="Dropdown" method="post">
        @Html.AntiForgeryToken()

        <div class="lookup-container position-relative"
             style="max-width:550px;">

            <label class="form-label">Select Person Group</label>

            <div class="input-group">
                <input type="text"
                       id="personDisplay"
                       class="form-control"
                       placeholder="Select a category..."
                       autocomplete="off"
                       readonly />

                <button type="button"
                        id="toggleDropdown"
                        class="btn btn-outline-secondary">
                    <i class="fa fa-chevron-down"></i>
                </button>
            </div>

            <input type="hidden"
                   id="SelectedCategoryCode"
                   name="SelectedCategoryCode"
                   value="@Model.SelectedCategoryCode" />

            <div id="personDropdown"
                 class="dropdown-table shadow bg-white border rounded mt-1"
                 style="display:none; position:absolute;
                        width:550px; z-index:1000;">

                <div class="p-2">
                    <input type="text"
                           id="personSearch"
                           class="form-control"
                           placeholder="Search category, group or code..." />
                </div>

                <div style="max-height:300px; overflow:auto;">
                    <table class="table table-bordered table-sm table-hover mb-0"
                           id="personTable">

                        <colgroup>
                             <col style="width:120px;" />
                            <col style="width:200px;" />
                           <col style="width:250px;" />
                        </colgroup>

                        <thead class="table-light"
                               style="position:sticky; top:0; z-index:1;">
                            <tr>
                               <th>
                                    <button type="button"
                                            class="btn btn-link p-0 text-dark text-decoration-none"
                                            data-sort="code">
                                        Category Code ↕
                                    </button>
                                </th>
                                <th>
                                    <button type="button"
                                            class="btn btn-link p-0 text-dark text-decoration-none"
                                            data-sort="group">
                                        Person Group Name ↕
                                    </button>
                                </th>
                                 <th>
                                    <button type="button"
                                            class="btn btn-link p-0 text-dark text-decoration-none"
                                            data-sort="category">
                                        Category Name ↕
                                    </button>
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr class="person-row"
                                    data-category="@item.CategoryName"
                                    data-group="@item.PersonGroupName"
                                    data-code="@item.CategoryCode"
                                    style="cursor:pointer;">

                                    <td>@item.CategoryCode</td>
                                    <td>@item.PersonGroupName</td>
                                    <td>@item.CategoryName</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div id="noResults"
                         class="text-center text-muted p-3"
                         style="display:none;">
                        No records found.
                    </div>
                </div>
            </div>

            <span asp-validation-for="SelectedCategoryCode"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary mt-3">
            Submit
        </button>
    </form>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-success mt-3">
            @ViewBag.Message
        </div>
    }
</div>

<style>
    #personTable {
        width: 570px;
        table-layout: fixed;
    }

    #personTable th,
    #personTable td {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        padding: 8px;
    }

    #personTable tbody tr:hover {
        background-color: #e9f2ff;
    }

    #personTable tbody tr.selected {
        background-color: #cfe2ff;
    }

    #personSearch {
        width: 100%;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {
            const $dropdown = $('#personDropdown');
            const $display = $('#personDisplay');
            const $selectedCode = $('#SelectedCategoryCode');
            const $search = $('#personSearch');
            const $rows = $('#personTable tbody tr');

            function openDropdown() {
                $dropdown.show();
                $search.trigger('focus');
                filterRows();
            }

            function closeDropdown() {
                $dropdown.hide();
            }

            function filterRows() {
                const term = ($search.val() || '')
                    .toLowerCase().trim();

                let visibleCount = 0;

                $rows.each(function () {
                    const $row = $(this);

                    const text = [
                        $row.attr('data-category'),
                        $row.attr('data-group'),
                        $row.attr('data-code')
                    ].join(' ').toLowerCase();

                    const matches = text.includes(term);

                    $row.toggle(matches);

                    if (matches) visibleCount++;
                });

                $('#noResults').toggle(visibleCount === 0);
            }

            function selectRow($row) {
                const category =
                    $row.attr('data-category') || '';

                const group =
                    $row.attr('data-group') || '';

                const code =
                    $row.attr('data-code') || '';

                $selectedCode.val(code);

                $display.val(
                    category + ' - ' + group + ' - ' + code
                );

                $rows.removeClass('selected');
                $row.addClass('selected');

                closeDropdown();
            }

            $('#toggleDropdown').on('click', function () {
                $dropdown.is(':visible')
                    ? closeDropdown()
                    : openDropdown();
            });

            $display.on('click', openDropdown);

            $search.on('input', filterRows);

            $rows.on('click', function () {
                selectRow($(this));
            });

            // Sort by clicking the column headers.
            const sortDirections = {
                category: true,
                group: true,
                code: true
            };

            $('[data-sort]').on('click', function (e) {
                e.preventDefault();

                const key = $(this).data('sort');
                const ascending = sortDirections[key];

                sortDirections[key] = !ascending;

                const sortedRows = $rows.get().sort(function (a, b) {
                    const va = (
                        $(a).attr('data-' + key) || ''
                    ).toLowerCase();

                    const vb = (
                        $(b).attr('data-' + key) || ''
                    ).toLowerCase();

                    const result = va.localeCompare(vb);

                    return ascending ? result : -result;
                });

                $('#personTable tbody').append(sortedRows);

                filterRows();
            });

            // Restore the selected category after POST.
            const selectedCode = $selectedCode.val();

            if (selectedCode) {
                const $row = $rows.filter(function () {
                    return $(this).attr('data-code') === selectedCode;
                }).first();

                if ($row.length) {
                    selectRow($row);
                }
            }

            // Close when clicking outside.
            $(document).on('click', function (e) {
                if (!$(e.target).closest(
                    '.lookup-container').length) {
                    closeDropdown();
                }
            });
        });
    </script>
}
