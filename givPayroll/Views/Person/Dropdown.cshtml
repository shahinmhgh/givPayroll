@model PersonDropdownViewModel

@{
    ViewData["Title"] = "انتخاب معین و تفصیلی";
}

<div class="container mt-4">
    <h4>انتخاب معین و تفصیلی</h4>

    <form asp-action="Dropdown" method="post">
        @Html.AntiForgeryToken()

        <div class="lookup-container position-relative"
             style="max-width:800px;">

            <label class="form-label">انتخاب معین</label>

            <div class="input-group">
                <input type="text"
                       id="personDisplay"
                       class="form-control"
                       placeholder="Select a category..."
                       autocomplete="off"
                       readonly />

                <button type="button"
                        id="toggleDropdown"
                        class="btn btn-outline-secondary">
                    <i class="fa fa-chevron-down"></i>
                </button>
            </div>

            <input type="hidden"
                   id="SelectedCategoryCode"
                   name="SelectedCategoryCode"
                   value="@Model.SelectedCategoryCode" />

            <div id="personDropdown"
                 class="dropdown-table shadow bg-white border rounded mt-1"
                 style="display:none; position:absolute;
                width:800px; z-index:1000;">

                <div class="p-2">
                    <input type="text"
                           id="personSearch"
                           class="form-control"
                           placeholder="Search category, group or code..." />
                </div>

                <div style="max-height:300px; overflow:auto;">
                    <table class="table table-bordered table-sm table-hover mb-0"
                           id="personTable">

                        <colgroup>
                            <col style="width:60px;" />
                            <col style="width:200px;" />
                        </colgroup>

                        <thead class="table-light"
                               style="position:sticky; top:0; z-index:1;">
                            <tr>
                                <th>
                                    <button type="button"
                                            class="btn btn-link p-0 text-dark text-decoration-none"
                                            data-sort="code">
                                        Category Code ↕
                                    </button>
                                </th>
                                <th>
                                    <button type="button"
                                            class="btn btn-link p-0 text-dark text-decoration-none"
                                            data-sort="group">
                                        Person Group Name ↕
                                    </button>
                                </th>
                               
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.ItemsMoin)
                            {
                                <tr class="person-row"
                                    data-category="@item.CategoryCode"
                                    data-group="@item.CategoryFullName"
                                    data-code="@item.CategoryCode"
                                    style="cursor:pointer;">

                                    <td>@item.CategoryCode</td>
                                    <td>@item.CategoryFullName</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div id="noResults"
                         class="text-center text-muted p-3"
                         style="display:none;">
                        No records found.
                    </div>
                </div>
            </div>

            <span asp-validation-for="SelectedCategoryCode"
                  class="text-danger"></span>
        </div>

        <div class="lookup-container position-relative mt-3"
             style="max-width:800px;">

            <label class="form-label">انتخاب تفصیلی</label>

            <select id="SelectedPersonID"
                    name="SelectedPersonID"
                    class="form-select"
                    disabled>
                <option value="">Select a category first...</option>
            </select>

            <span asp-validation-for="SelectedPersonID"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary mt-3">
            Submit
        </button>
    </form>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-success mt-3">
            @ViewBag.Message
        </div>
    }
</div>

<style>
    #personTable {
        width: 830px;
        table-layout: fixed;
    }

        #personTable th,
        #personTable td {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            padding: 8px;
        }

        #personTable tbody tr:hover {
            background-color: #e9f2ff;
        }

        #personTable tbody tr.selected {
            background-color: #cfe2ff;
        }

    #personSearch {
        width: 100%;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function() {

            

            const $personSelect = $('#SelectedPersonID');
            
            const $dropdown = $('#personDropdown');
            const $display = $('#personDisplay');
            const $selectedCode = $('#SelectedCategoryCode');
            const $search = $('#personSearch');
            const $rows = $('#personTable tbody tr');

            const selectedCategory = $selectedCode.val();
            const selectedPersonID = '@Model.SelectedPersonID';

            if (selectedCategory) {
                
                loadTafsilPersons(selectedCategory, selectedPersonID);
                // alert(selectedPersonID);
                
            }

            function openDropdown() {
                $dropdown.show();
                $search.trigger('focus');
                filterRows();
            }

            function closeDropdown() {
                $dropdown.hide();
            }
 
            function fixPersianChars(text) {
                if (!text) return text;

                return text
                    .replace('ی', 'ي')
                    .replace('ک', 'ك');
            }

            function filterRows() {
                let term = ($search.val() || '')
                    .toLowerCase().trim();

                term = fixPersianChars(term);
                //alert(term);
                let visibleCount = 0;

                $rows.each(function() {
                    const $row = $(this);

                    const text = [
                        $row.attr('data-category'),
                        $row.attr('data-group'),
                        $row.attr('data-code')
                    ].join(' ').toLowerCase();

                    const matches = text.includes(term);

                    $row.toggle(matches);

                    if (matches) visibleCount++;
                });

                $('#noResults').toggle(visibleCount === 0);
            }

            function selectRow($row) {
                const category =
                    $row.attr('data-category') || '';

                const group =
                    $row.attr('data-group') || '';

                const code =
                    $row.attr('data-code') || '';

                $selectedCode.val(code);
                $selectedCode.trigger('change');

                $display.val(
                    category + ' - ' + group + ' - ' + code
                );

                $rows.removeClass('selected');
                $row.addClass('selected');

                closeDropdown();
            }

            function loadTafsilPersons(categoryCode, selectedPersonID) {
                $personSelect.empty();

                if (!categoryCode) {
                    $personSelect
                        .append(new Option('Select a category first...', ''))
                        .prop('disabled', true);

                    return;
                }

                $personSelect
                    .append(new Option('Loading persons...', ''))
                    .prop('disabled', true);

                $.ajax({
                    url: '/Person/GetTafsilPersons',
                    type: 'GET',
                    data: { categoryCode: categoryCode },

                    success: function(persons) {
                        $personSelect.empty();

                        $personSelect.append(
                            new Option('Select a person...', '')
                        );

                        $.each(persons, function(_, person) {
                            const displayText =
                                person.personGroupName + ' - ' +
                                person.personFullName + ' - ' +
                                person.personID;

                            const option = new Option(
                                displayText,
                                person.personID
                            );

                            if (selectedPersonID != null &&
                                String(person.personID) ===
                                String(selectedPersonID)) {
                                option.selected = true;
                            }

                            $personSelect.append(option);
                        });

                        $personSelect.prop('disabled', false);

                        $('#SelectedPersonID').select2({
                            width: '100%',
                            dir: 'rtl',
                            // placeholder: '-- انتخاب پرسنل --',
                            allowClear: false,
                            // dropdownParent: $('#personnelOrderModal')
                        });
                      
                    },

                    error: function() {
                        $personSelect.empty()
                            .append(new Option('Error loading persons', ''))
                            .prop('disabled', true);
                    }
                });
            }

            $('#toggleDropdown').on('click', function() {
                $dropdown.is(':visible')
                    ? closeDropdown()
                    : openDropdown();
            });

            $selectedCode.on('change', function() {
                loadTafsilPersons($(this).val(), null);
            });

            $display.on('click', openDropdown);

            $search.on('input', filterRows);

            $rows.on('click', function() {
                selectRow($(this));
            });

            // Sort by clicking the column headers.
            const sortDirections = {
                category: true,
                group: true,
                code: true
            };

            $('[data-sort]').on('click', function(e) {
                e.preventDefault();

                const key = $(this).data('sort');
                const ascending = sortDirections[key];

                sortDirections[key] = !ascending;

                const sortedRows = $rows.get().sort(function(a, b) {
                    const va = (
                        $(a).attr('data-' + key) || ''
                    ).toLowerCase();

                    const vb = (
                        $(b).attr('data-' + key) || ''
                    ).toLowerCase();

                    const result = va.localeCompare(vb);

                    return ascending ? result : -result;
                });

                $('#personTable tbody').append(sortedRows);

                filterRows();
            });

            // Restore the selected category after POST.
            const selectedCode = $selectedCode.val();

            if (selectedCode) {
                const $row = $rows.filter(function() {
                    return $(this).attr('data-code') === selectedCode;
                }).first();

                if ($row.length) {
                    selectRow($row);
                }
            }

            // Close when clicking outside.
            $(document).on('click', function(e) {
                if (!$(e.target).closest(
                    '.lookup-container').length) {
                    closeDropdown();
                }
            });
        });
    </script>
}
