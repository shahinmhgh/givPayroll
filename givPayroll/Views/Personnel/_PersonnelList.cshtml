@using System.ComponentModel.DataAnnotations
@using System.Globalization
@model PagedResult<Personnel>
<link rel="stylesheet" href="~/pages/css/table.css" />
<link href="~/pages/css/tooltip.css" rel="stylesheet" />

<div id="tableContainer" style="border: 1px solid lightgray">
    <table class="table table-bordered ">

        <thead class="colorWhitesmoke">

            <tr>
                <th class="colorWhitesmoke fixed-column">
                    #
                </th>
               
                <th class="colorWhitesmoke" onclick="sortTable('Id')"
                    style="cursor:pointer">
                     @Html.DisplayNameFor(m => m.Items.First().Id)
                    <span>
                        @if (ViewBag.SortColumn == "Id")
                        {
                            @(ViewBag.SortDirection == "asc" ? "▲" : "▼")
                        }
                        else
                        {
                            @("↕")
                        }
                    </span>
                </th>

         @*        <th class="colorWhitesmoke"
                    onclick="sortTable('BirthDate')"
                    style="cursor:pointer">

                    تاریخ شروع قرارداد

                    <span>
                        @if (ViewBag.SortColumn == "BirthDate")
                        {
                            @(ViewBag.SortDirection == "asc" ? "▲" : "▼")
                        }
                        else
                        {
                            @("↕")
                        }
                    </span>

                </th>
 *@
                <th class="colorWhitesmoke" onclick="sortTable('FirstName')"
                    style="cursor:pointer">
                    @Html.DisplayNameFor(m => m.Items.First().FirstName)
                    <span>
                        @if (ViewBag.SortColumn == "FirstName")
                        {
                            @(ViewBag.SortDirection == "asc" ? "▲" : "▼")
                        }
                        else
                        {
                            @("↕")
                        }
                    </span>
                </th>


                <th class="colorWhitesmoke" onclick="sortTable('LastName')"
                    style="cursor:pointer">
                    @Html.DisplayNameFor(m => m.Items.First().LastName)
                    <span>
                        @if (ViewBag.SortColumn == "LastName")
                        {
                            @(ViewBag.SortDirection == "asc" ? "▲" : "▼")
                        }
                        else
                        {
                            @("↕")
                        }
                    </span>
                </th>

                <th class="colorWhitesmoke"
                    onclick="sortTable('MaritalStatus')"
                    style="cursor:pointer">

                    وضعیت تاهل

                    <span>
                        @if (ViewBag.SortColumn == "MaritalStatus")
                        {
                            @(ViewBag.SortDirection == "asc" ? "▲" : "▼")
                        }
                        else
                        {
                            @("↕")
                        }
                    </span>

                </th>

                <th class="colorWhitesmoke"
                    style="cursor:pointer"
                    onclick="sortTable('BirthDate')">

                    تاریخ تولد

                    <span>
                        @if (ViewBag.SortColumn == "BirthDate")
                        {
                            @(ViewBag.SortDirection == "asc" ? "▲" : "▼")
                        }
                        else
                        {
                            @("↕")
                        }
                    </span>

                </th>
               

                <th class="colorWhitesmoke" style="width:160px;">
                    عملیات
                </th>

            </tr>

        </thead>


        <tbody>
            @{
                int rowNumber =  (Model.PageNumber - 1) * Model.PageSize + 1;
            }
            @foreach (var p in Model.Items)
            {
                <tr>
                    <td class="colorWhitesmoke fixed-column">
                        @rowNumber
                    </td>
                    <td>@p.Id</td>
                    <td>@p.FirstName</td>
                    <td>@p.LastName</td>
                    <td>
                        @p.MaritalStatus?.MaritalStatusName
                    </td>
                    <td>
                        @if (p.BirthDate.HasValue)
                        {
                            var pc = new PersianCalendar();
                            var date = p.BirthDate.Value;

                            @($"{pc.GetYear(date):0000}/{pc.GetMonth(date):00}/{pc.GetDayOfMonth(date):00}")
                        }
                    </td>
                  @*    <td>
                        @if (p.ContractFinished)
                        {
                            <span class="badge bg-danger">
                                خاتمه یافته
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                فعال
                            </span>
                        }
                    </td> *@

                    <td>

                        <button class=" btn btn-sm btn-warning tooltip-btn"
                                onclick="editPersonnel(@p.Id)" >
                            <i class="fa fa-edit"></i>
                            <span class="tooltip-text">ویرایش</span>
                        </button>
 
                        <button class="btn btn-sm btn-danger tooltip-btn"
                                onclick="deletePersonnel(@p.Id)">
                           <i class="fa fa-trash"></i>
                            <span class="tooltip-text">حذف</span>
                        </button>
                        <button class="btn btn-sm btn-info tooltip-btn"
                                onclick="reportPersonnel(@p.Id)">
                            <i class="fa fa-list-alt "></i>
                            <span class="tooltip-text">فیش حقوق</span>
                        </button>
                        <button class=" btn btn-sm btn-info tooltip-btn"
                                onclick="listPersonnelFamily(@p.Id)">
                            <i class="fa fa-user"></i>
                            <span class="tooltip-text">وابستگان</span>
                        </button>
                    </td>

                </tr>

                rowNumber++;
            }

        </tbody>

    </table>
</div>
 
<div id="pagerArea" class="mt-3 d-flex justify-content-between">


    <div>

       
        <select asp-for="PageSize"
                asp-items="Model.PageSizes"
                class="form-select"
                onchange="changePageSize(this.value)">
        </select>
    </div>



    <div >

        <button class="btn btn-secondary"
                onclick="goPage(1)">
            اول
        </button>


        <button class="btn btn-secondary"
                onclick="goPage(@(Model.PageNumber - 1))">
            قبلی
        </button>



        <span class="mx-2">
            @Model.PageNumber / @Model.TotalPages
        </span>


        <button class="btn btn-secondary"
                onclick="goPage(@(Model.PageNumber + 1))">
            بعدی
        </button>


        <button class="btn btn-secondary"
                onclick="goPage(@Model.TotalPages)">
            آخر
        </button>


    </div>


</div>



<script>
    document.addEventListener("DOMContentLoaded", function() {
        document.querySelectorAll('[data-bs-toggle="tooltip"]')
            .forEach(el => new bootstrap.Tooltip(el));
    });
    function goPage(page)
    {
     if(page < 1 ||
        page > @Model.TotalPages)
        return;


     currentPage=page;

     loadData();
    }
 
    function changePageSize(size)
    {
        pageSize = parseInt(size);
        currentPage=1;
        loadData();
    }

</script>