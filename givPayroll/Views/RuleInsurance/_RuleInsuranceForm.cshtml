@model RuleInsuranceViewModel

@{
    bool isEdit = Model.Id != 0;
}

<form id="ruleInsuranceForm" method="post">

    @Html.AntiForgeryToken()

    <input asp-for="Id" type="hidden" />


    <!-- HEADER -->

    <div class="modal-header">

        <h5 class="modal-title">

            @(isEdit
                ? "ویرایش قانون بیمه"
                : "قانون بیمه جدید")

        </h5>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal">
        </button>

    </div>


    <!-- BODY -->

    <div class="modal-body">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <div class="row g-3">


            <!-- Insurance Group -->

            <div class="col-md-6">

                <label asp-for="RuleInsuranceGroupId"
                       class="form-label">
                </label>

                <select asp-for="RuleInsuranceGroupId"
                        asp-items="Model.RuleInsuranceGroupList"
                        class="form-select">

                    <option value="">
                        -- انتخاب گروه بیمه --
                    </option>

                </select>

                <span asp-validation-for="RuleInsuranceGroupId"
                      class="text-danger">
                </span>

            </div>


            <!-- Effective Date -->

            <div id="EffectiveDateApp" class="col-md-6">
                <label class="form-label">
                    تاریخ اجرا
                </label>
                <date-picker v-model="persianDate"
                             format="jYYYY/jMM/jDD"
                             display-format="jYYYY/jMM/jDD"
                             color="#0d6efd"
                             :editable="true"
                             placeholder="تاریخ اجرا">
                </date-picker>

                <input type="hidden"
                       name="EffectiveDate"
                       :value="gregorianDate">

            </div>


            <!-- Employee Rate -->

            <div class="col-md-4">

                <label asp-for="EmployeeRate"
                       class="form-label">
                </label>

                <div class="input-group">

                    <input asp-for="EmployeeRate"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0"
                           max="100"
                           dir="ltr" />

                    <span class="input-group-text">
                        %
                    </span>

                </div>

                <span asp-validation-for="EmployeeRate"
                      class="text-danger">
                </span>

            </div>


            <!-- Employer Rate -->

            <div class="col-md-4">

                <label asp-for="EmployerRate"
                       class="form-label">
                </label>

                <div class="input-group">

                    <input asp-for="EmployerRate"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0"
                           max="100"
                           dir="ltr" />

                    <span class="input-group-text">
                        %
                    </span>

                </div>

                <span asp-validation-for="EmployerRate"
                      class="text-danger">
                </span>

            </div>


            <!-- Unemployment Rate -->

            <div class="col-md-4">

                <label asp-for="UnemploymentRate"
                       class="form-label">
                </label>

                <div class="input-group">

                    <input asp-for="UnemploymentRate"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0"
                           max="100"
                           dir="ltr" />

                    <span class="input-group-text">
                        %
                    </span>

                </div>

                <span asp-validation-for="UnemploymentRate"
                      class="text-danger">
                </span>

            </div>

        </div>

    </div>


    <!-- FOOTER -->

    <div class="modal-footer">

        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">

            انصراف

        </button>

        <button type="button"
                class="btn btn-primary"
                onclick="saveRuleInsurance()">

            <i class="bi bi-check-lg"></i>

            ذخیره

        </button>

    </div>

</form>


<script>

    $(document).ready(function() {

        var EffectiveDate = '@Model.EffectiveDate';

        initEffectiveDatePicker(EffectiveDate, "#EffectiveDateApp")

    });

    var EffectiveDatePicker = null;

    function initEffectiveDatePicker(EffectiveDate, elmnt) {

        const element = $(elmnt); // document.getElementById(elmnt);

        if (!element) {
            return;
        }

        // Destroy previous Vue instance if the modal was loaded again
        if (EffectiveDatePicker) {
            EffectiveDatePicker.$destroy();
            EffectiveDatePicker = null;
        }

        let initialPersianDate = "";

        if (EffectiveDate) {
            initialPersianDate =
                moment(EffectiveDate, "M/D/YYYY h:mm:ss A")
                    .format("jYYYY/jMM/jDD");
        }

        EffectiveDatePicker = new Vue({

            el: elmnt,

            data: {
                persianDate: initialPersianDate
            },

            components: {
                DatePicker: VuePersianDatetimePicker
            },

            computed: {

                gregorianDate() {

                    if (!this.persianDate) {
                        return "";
                    }

                    return moment(
                        this.persianDate,
                        "jYYYY/jMM/jDD",
                        true
                    ).format("YYYY-MM-DD");
                }

            }

        });
    }

    $.validator.unobtrusive.parse(
        '#ruleInsuranceForm'
    );


    function saveRuleInsurance() {

        const form =
            $("#ruleInsuranceForm");

        if (!form.valid()) {
            return false;
        }


        const id =
            $("[name='Id']", form).val();


        const url =
            id == 0
                ? '/RuleInsurance/Create'
                : '/RuleInsurance/Edit';


        $.ajax({

            url: url,

            type: "POST",

            data: form.serialize(),

            success: function(result) {
                
                if (result.success) {

                    $("#ruleInsuranceModal")
                        .modal("hide");

                    loadData();

                    Swal.fire({
                        icon: "success",
                        title: result.message,
                        timer: 1200,
                        showConfirmButton: false
                    });

                }
                else {

                    $("#ruleInsuranceModalBody")
                        .html(result);

                    $.validator.unobtrusive.parse(
                        "#ruleInsuranceForm"
                    );
                }
            },

            error: function() {

                Swal.fire({
                    icon: "error",
                    title: "ثبت انجام نشد"
                });

            }

        });

        return false;
    }

</script>