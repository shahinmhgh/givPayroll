@model givPayroll.Models.SalaryItem

@{
    bool isEdit = Model.Id != 0;

    string action =
        isEdit ? "Edit" : "Create";
}

<form id="salaryItemForm"
      asp-action="@action"
      asp-controller="SalaryItem"
      method="post"
      onsubmit="return submitSalaryItemForm(this);">

    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <label id="PersonID1Field" hidden>@Model.PersonID1</label>
    <label id="PersonID2Field" hidden>@Model.PersonID2</label>
    <label id="fldIsSystem" hidden>@Model.IsSystem</label>

    <div class="modal-header">
        <h5 class="modal-title">
            @(isEdit ? "ویرایش قلم حقوق" : "قلم حقوق جدید")
        </h5>
        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal">
        </button>
    </div>

    <div class="modal-body">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <div class="row g-3">

            <!-- Id  -->
            <!-- Priority -->

            <div class="col-md-2">
                <label asp-for="Priority"
                       class="form-label">
                </label>
                <input asp-for="Priority"
                       class="form-control"
                       type="number" />
                <span asp-validation-for="Priority"
                      class="text-danger">
                </span>
            </div>

            <!-- Name -->

            <div class="col-md-4">
                <label asp-for="SalaryItemName"
                       class="form-label">
                </label>
                <input asp-for="SalaryItemName"
                       class="form-control" />
                <span asp-validation-for="SalaryItemName"
                      class="text-danger">
                </span>
            </div>

            <!-- Label -->

            <div class="col-md-4">
                <label asp-for="Label"
                       class="form-label">
                </label>
                <input asp-for="Label"
                       class="form-control"
                       dir="ltr" />
            </div>

            <!-- Source -->
            <div class="col-md-3">

                <label asp-for="Source"
                       class="form-label">
                </label>

                <select asp-for="Source"
                        class="form-select">

                    <option value="">-- انتخاب --</option>
                    <option value="PersonnelOrder">حکم پرسنلی</option>   <!--    Formula -->
                    <option value="Attendance">حضور و غیاب</option>      <!--    Formula -->
                    <option value="RuleInsurance">قوانین بیمه</option>   <!-- No Formula -->
                    <option value="RuleTax">قوانین مالیات</option>       <!-- No Formula -->
                    <option value="SalaryItemRule">مولفه آزاد</option>   <!--    Formula -->
                </select>

            </div>

            <!-- PlusMinus -->
            <div class="col-md-3">
                <label asp-for="PlusMinus"
                       class="form-label">
                </label>
                <select asp-for="PlusMinus"
                        class="form-select">
                    <option value="1">
                        +
                    </option>

                    <option value="-1">
                        -
                    </option>
                </select>
            </div>

            <!-- Formula -->
            <div class="col-12">
                <label asp-for="FormulaValue"
                       class="form-label">
                </label>
                <textarea asp-for="FormulaValue"
                          class="form-control"
                          rows="4"
                          dir="ltr"
                          style="font-family:Consolas,monospace;">
                </textarea>
                <span asp-validation-for="FormulaValue"
                      class="text-danger">
                </span>
            </div>

            <!-- Accounting start -->
            <div class="row" id="accRow1" style="margin-top:5px;">
                <label class="form-label" style="background-color:whitesmoke;border:1px solid black"> بدهکار </label>
                <div class="col-md-2">
                    <label class="form-label"> @Html.DisplayNameFor(m => m.ProjectId1) </label>
                    <select asp-for="ProjectId1" asp-items="ViewBag.ProjectId" class="form-select">
                        <option value=""> -- پروژه را انتخاب کنید -- </option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label"> @Html.DisplayNameFor(m => m.PersonCategoryCode1) </label>
                    <select asp-for="PersonCategoryCode1" asp-items="ViewBag.PersonCategoryCode" class="form-select">
                        <option value=""> -- کد معین را انتخاب کنید -- </option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="PersonID1" class="form-label"></label>

                    <select asp-for="PersonID1"
                            asp-items="ViewBag.PersonID1"
                            class="form-select"
                            id="PersonID1">
                        <option value="">-- کد تفصیلی را انتخاب کنید --</option>
                    </select>
                </div>
            </div>

            <div class="row" id="accRow2">
                <label class="form-label" style="background-color:whitesmoke; border:1px solid black"> بستانکار </label>
                <div class="col-md-2">
                    <label class="form-label"> @Html.DisplayNameFor(m => m.ProjectId2) </label>
                    <select asp-for="ProjectId2" asp-items="ViewBag.ProjectId" class="form-select">
                        <option value=""> -- پروژه را انتخاب کنید -- </option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label"> @Html.DisplayNameFor(m => m.PersonCategoryCode2) </label>
                    <select asp-for="PersonCategoryCode2" asp-items="ViewBag.PersonCategoryCode" class="form-select">
                        <option value=""> -- کد معین را انتخاب کنید -- </option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="PersonID2" class="form-label"></label>

                    <select asp-for="PersonID2"
                            asp-items="ViewBag.PersonID2"
                            class="form-select"
                            id="PersonID2">
                        <option value="">-- کد تفصیلی را انتخاب کنید --</option>
                    </select>
                </div>
            </div>

            <!-- Accounting end -->

        
        </div>

    </div>


    <div class="modal-footer">

        <button type="button"
                class="btn btn-secondary me-auto"
                onclick="ListWords()">
            راهنما
        </button>

    
        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            انصراف
        </button>

        <button type="button"
                onclick="saveSalaryItem()"
                class="btn btn-primary">

            <i class="bi bi-check-lg"></i>

            ذخیره

        </button>

    </div>

</form>

<!-- =========================================================
         LOADING
         ========================================================= -->

<div id="salaryItemLoading"
     class="modal-loading"
     style="display:none;">

    <img src="~/images/hourglass.gif"
         alt="ذخیره ..." />

</div>

<script>
    let formulaDictionary = [];

    function ListWords(silent) {
        $.get('/SalaryItem/GetFormulaDictionary')
            .done(function(data) {

                formulaDictionary = data;
                console.log(formulaDictionary);

                if (!silent)
                    alert(formulaDictionary.join("\n"));
            });
    }

    function LoadForm() {

        
        var source = $("#Source").val();
        $("#accRow2").prop("hidden", true);

        if (source == "RuleInsurance" || source == "RuleTax") {
            $("#accRow2").prop("hidden", false);
        }

        $('#PersonCategoryCode1').trigger('change');
        $('#PersonCategoryCode2').trigger('change');

        ListWords(true);

        var source = $("#Source").val();
        // <option value="PersonnelOrder">حکم پرسنلی</option>   <!--    Formula -->
        // <option value="Attendance">حضور و غیاب</option>      <!--    Formula -->
        // <option value="RuleInsurance">قوانین بیمه</option>   <!-- No Formula -->
        // <option value="RuleTax">قوانین مالیات</option>       <!-- No Formula -->
        // <option value="SalaryItemRule">مولفه آزاد</option>   <!--    Formula -->
        switch (source) {
            case "PersonnelOrder":
                $("#FormulaValue").prop("readonly", false);
                break;

            case "Attendance":
                $("#FormulaValue").prop("readonly", false);
                break;

            case "RuleInsurance":
                $("#FormulaValue").prop("readonly", true);
                break;
            case "RuleTax":
                $("#FormulaValue").prop("readonly", true);
                break;

            case "SalaryItemRule":
                $("#FormulaValue").prop("readonly", false);
                break;

            default:

                break;
        }

        var isSystem = $("#fldIsSystem")[0].innerText;

        if (isSystem == 1) {
            $("#SalaryItemName").prop("readonly", true);
            $("#BaseSalary").prop("readonly", true);
            $("#Source").on("mousedown keydown", function(e) {
                e.preventDefault();
            });
            $("#PlusMinus").on("mousedown keydown", function(e) {
                e.preventDefault();
            });
            $("#Label").prop("readonly", true);
            $("#FormulaValue").prop("readonly", true);
        }
    }

    $(document).on('change', '#PersonCategoryCode1', function() {
        var IsSystem = '@Model.IsSystem';

        

        $('#PersonCategoryCode1').select2({
            width: '100%',
            dir: 'rtl',
            // placeholder: '-- انتخاب پرسنل --',
            allowClear: false,
            dropdownParent: $('#salaryItemModal')
        });
        var categoryCode = $(this).val();
        var personDropdown = $('#PersonID1');
        // Reset the persons dropdown
        personDropdown.empty();
        personDropdown.append(
            $('<option>', {
                value: '',
                text: '-- کد تفصیلی را انتخاب کنید --'
            })
        );
        // No category selected
        if (!categoryCode) {
            personDropdown.prop('disabled', true);
            return;
        }
        personDropdown.prop('disabled', true);

        if (IsSystem) {
            //personDropdown.prop('readonly', true);
        }

        $.ajax({
            url: '/SalaryItem/GetPersonsByCategoryCode',
            type: 'GET',
            data: { categoryCode: categoryCode },
            success: function(persons) {
                $.each(persons, function(index, person) {
                    personDropdown.append(
                        $('<option>', {
                            value: person.value,
                            text: person.text
                        })
                    );
                });
                $('#PersonID1').select2({
                    width: '100%',
                    dir: 'rtl',
                    // placeholder: '-- انتخاب پرسنل --',
                    allowClear: false,
                    dropdownParent: $('#salaryItemModal')
                });

                var PersonID1Field = $("#PersonID1Field")[0].innerText;
                $("#PersonID1").val(PersonID1Field).trigger('change');
                personDropdown.prop('disabled', false);
            },
            error: function(xhr) {
                console.error(xhr);

                alert('خطا در دریافت فهرست کدهای تفصیلی');
                personDropdown.prop('disabled', false);
            }
        });
    });

    $(document).on('change', '#PersonCategoryCode2', function() {
        $('#PersonCategoryCode2').select2({
            width: '100%',
            dir: 'rtl',
            // placeholder: '-- انتخاب پرسنل --',
            allowClear: false,
            dropdownParent: $('#salaryItemModal')
        });
        var categoryCode = $(this).val();
        var personDropdown = $('#PersonID2');
        // Reset the persons dropdown
        personDropdown.empty();
        personDropdown.append(
            $('<option>', {
                value: '',
                text: '-- کد تفصیلی را انتخاب کنید --'
            })
        );
        // No category selected
        if (!categoryCode) {
            personDropdown.prop('disabled', true);
            return;
        }
        personDropdown.prop('disabled', true);
        $.ajax({
            url: '/SalaryItem/GetPersonsByCategoryCode',
            type: 'GET',
            data: { categoryCode: categoryCode },
            success: function(persons) {
                $.each(persons, function(index, person) {
                    personDropdown.append(
                        $('<option>', {
                            value: person.value,
                            text: person.text
                        })
                    );
                });
                $('#PersonID2').select2({
                    width: '100%',
                    dir: 'rtl',
                    // placeholder: '-- انتخاب پرسنل --',
                    allowClear: false,
                    dropdownParent: $('#salaryItemModal')
                });

                var PersonID2Field = $("#PersonID2Field")[0].innerText;
                $("#PersonID2").val(PersonID2Field).trigger('change');
                personDropdown.prop('disabled', false);
            },
            error: function(xhr) {
                console.error(xhr);

                alert('خطا در دریافت فهرست کدهای تفصیلی');
                personDropdown.prop('disabled', false);
            }
        });
    });

    $(document).ready(function() {
        $('#PersonCategoryCode1').trigger('change');
        $('#PersonCategoryCode2').trigger('change');
    });

    function validateFormula() {
        console.log(formulaDictionary);

         
        const formula = $("#FormulaValue").val().trim();

        if (!formula) {
            return {
                valid: true,
                invalidWords: []
            };
        }

        // Get words/identifiers from formula
        // Supports English letters, numbers and underscore
        const words = formula.match(/[A-Za-z_][A-Za-z0-9_]*/g) || [];

        // Remove duplicates
        const uniqueWords = [...new Set(words)];

        // Dictionary comparison
        const dictionarySet = new Set(
            formulaDictionary.map(x => x.toLowerCase())
        );
        console.log(uniqueWords);
        console.log(formula);
        console.log(dictionarySet);

        const invalidWords = uniqueWords.filter(word =>
            !dictionarySet.has(word.toLowerCase())
        );

        if (invalidWords == $('#Label').val()) {
            return {
                valid: true,
                invalidWords: []
            };
        }

        return {
            valid: invalidWords.length === 0,
            invalidWords: invalidWords
        };
    }

    function saveSalaryItem() {

        var form = $("#salaryItemForm");
        var id = $("#Id").val();

      

        if (!form.valid()) {
            form.validate().errorList.forEach(function (error) {
                console.log(error.message + " " + error.no);
            });
             
                return false;
        }

        const formulaResult = validateFormula();

        if (!formulaResult.valid) {

            Swal.fire({
                icon: "warning",
                title: "فرمول نامعتبر است",
                html:
                    "کلمات زیر در فرهنگ لغات فرمول وجود ندارند:<br><br>" +
                    "<b>" +
                    formulaResult.invalidWords.join(" ، ") +
                    "</b>",
                confirmButtonText: "متوجه شدم"
            });

            return false;
        }

        $("#btnSaveSalaryItem")
            .prop("disabled", true)
            .html(
                '<img src="/images/hourglass.gif" ' +
                'style="width:20px;height:20px;"> ' +
                'در حال ذخیره...'
            );

        

        //$("#salaryItemLoading").show();

        var url = (id == 0 ? "/SalaryItem/Create" : "/SalaryItem/Edit");

        $.ajax({
            url: url,
            type: "POST",
            data: form.serialize(),
            success: function(result) {

                if (result.success) {
                    $("#salaryItemModal").modal("hide");

                    Swal.fire({
                        icon: "success",
                        title: "قوانین با موفقیت ذخیره شد",
                        timer: 1200,
                        showConfirmButton: false
                    });
                    // window.location.href = window.location.href;
                    loadSalaryItems();
                }
                else {

                    $("#salaryItemRuleModalContent").html(result);


                    $.validator.unobtrusive.parse(
                        "#salaryItemRuleForm"
                    );

                }

            },


            error: function(xhr) {

                console.error(xhr);


                Swal.fire({

                    icon:
                        "error",

                    title:
                        "ذخیره انجام نشد",

                    text:
                        "خطایی هنگام ذخیره قوانین رخ داد."

                });

            },
            complete: function() {
                $("#salaryItemRuleLoading")
                    .hide();
                $("#btnSaveSalaryItemRule")
                    .prop("disabled", false)
                    .html("ثبت");
            }
        });


        return false;
    }
</script>
<script>

    $.validator.unobtrusive.parse(
        '#salaryItemForm'
    );

</script>