@model givPayroll.Models.SalaryItem

@{
    bool isEdit = Model.Id != 0;

    string action =
        isEdit ? "Edit" : "Create";
}

<form id="salaryItemForm"
      asp-action="@action"
      asp-controller="SalaryItem"
      method="post"
      onsubmit="return submitSalaryItemForm(this);">

    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="modal-header">

        <h5 class="modal-title">
            @(isEdit ? "ویرایش قلم حقوق" : "قلم حقوق جدید")
        </h5>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal">
        </button>

    </div>


    <div class="modal-body">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <div class="row g-3">

            <!-- Id  -->
            <!-- Priority -->

            <div class="col-md-2">

                <label asp-for="Priority"
                       class="form-label">
                </label>

                <input asp-for="Priority"
                       class="form-control"
                       type="number" />

                <span asp-validation-for="Priority"
                      class="text-danger">
                </span>

            </div>


            <!-- Name -->

            <div class="col-md-4">

                <label asp-for="SalaryItemName"
                       class="form-label">
                </label>

                <input asp-for="SalaryItemName"
                       class="form-control" />

                <span asp-validation-for="SalaryItemName"
                      class="text-danger">
                </span>

            </div>


            <!-- Label -->

            <div class="col-md-4">

                <label asp-for="Label"
                       class="form-label">
                </label>

                <input asp-for="Label"
                       class="form-control"
                       dir="ltr" />

            </div>


            <!-- Unit -->
            @* <div class="col-md-3">

                <label asp-for="Unit"
                       class="form-label">
                </label>

                <select asp-for="Unit"
                        class="form-select">

                    <option value="">-- انتخاب --</option>
                    <option value="Amount">Amount</option>
                    <option value="Hour">Hour</option>
                    <option value="Day">Day</option>
                    <option value="Percent">Percent</option>

                </select>

            </div> *@


            <!-- Source -->
            <div class="col-md-3">

                <label asp-for="Source"
                       class="form-label">
                </label>

                <select asp-for="Source"
                        class="form-select">

                    <option value="">-- انتخاب --</option>
                    <option value="PersonnelOrder">حکم پرسنلی</option>   <!--    Formula -->
                    <option value="Attendance">حضور و غیاب</option>      <!--    Formula -->
                    <option value="RuleInsurance">قوانین بیمه</option>   <!-- No Formula -->
                    <option value="RuleTax">قوانین مالیات</option>       <!-- No Formula -->
                    <option value="SalaryItemRule">مولفه آزاد</option>   <!--    Formula -->
                </select>

            </div>


            <!-- PlusMinus -->

            <div class="col-md-3">

                <label asp-for="PlusMinus"
                       class="form-label">
                </label>

                <select asp-for="PlusMinus"
                        class="form-select">

                    <option value="1">
                        +
                    </option>

                    <option value="-1">
                        -
                    </option>

                </select>

            </div>


            <!-- CalculationMode -->
            @*  <div class="col-md-3">

                <label asp-for="CalculationMode"
                       class="form-label">
                </label>

                <select asp-for="CalculationMode"
                        class="form-select">

                    <option value="">-- انتخاب --</option>
                    <option value="Formula">Formula</option>
                    <option value="Manual">Manual</option>
                    <option value="Tax">Tax</option>
                    <option value="Insurance">Insurance</option>

                </select>

            </div> *@


            <!-- Formula -->

            <div class="col-12">

                <label asp-for="FormulaValue"
                       class="form-label">
                </label>

                <textarea asp-for="FormulaValue"
                          class="form-control"
                          rows="4"
                          dir="ltr"
                          style="font-family:Consolas,monospace;">
                </textarea>

                <span asp-validation-for="FormulaValue"
                      class="text-danger">
                </span>

            </div>


            <!-- Accounting -->

            <div class="col-md-6">

                <label asp-for="AccAccountCode"
                       class="form-label">
                </label>

                <input asp-for="AccAccountCode"
                       class="form-control"
                       dir="ltr" />

            </div>


            <div class="col-md-6">

                <label asp-for="AccUniqueId"
                       class="form-label">
                </label>

                <input asp-for="AccUniqueId"
                       class="form-control"
                       type="number"
                       dir="ltr" />

            </div>

        </div>

    </div>


    <div class="modal-footer">

        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            انصراف
        </button>

        <button type="button"
                onclick="saveSalaryItem()"
                class="btn btn-primary">

            <i class="bi bi-check-lg"></i>

            ذخیره

        </button>

    </div>

</form>

<!-- =========================================================
         LOADING
         ========================================================= -->

<div id="salaryItemLoading"
     class="modal-loading"
     style="display:none;">

    <img src="~/images/hourglass.gif"
         alt="ذخیره ..." />

</div>

<script>
    $(document).ready(function() {
        
        

        var source = $("#Source").val();
        // <option value="PersonnelOrder">حکم پرسنلی</option>   <!--    Formula -->
        // <option value="Attendance">حضور و غیاب</option>      <!--    Formula -->
        // <option value="RuleInsurance">قوانین بیمه</option>   <!-- No Formula -->
        // <option value="RuleTax">قوانین مالیات</option>       <!-- No Formula -->
        // <option value="SalaryItemRule">مولفه آزاد</option>   <!--    Formula -->
       switch (source) {
            case "PersonnelOrder":
                $("#FormulaValue").prop("readonly", false);
                break;

            case "Attendance":
                $("#FormulaValue").prop("readonly", false);
                break;

            case "RuleInsurance":
                $("#FormulaValue").prop("readonly", true);
                break;
            case "RuleTax":
                $("#FormulaValue").prop("readonly", true);
                break;

            case "SalaryItemRule":
                $("#FormulaValue").prop("readonly", false);
                break;

            default:
                 
                break;
        }
            
    });

    function saveSalaryItem() {

        var form = $("#salaryItemForm");
        var id = $("#Id").val();

        if (!form.valid()) {
            return false;
        }

        $("#btnSaveSalaryItem")
            .prop("disabled", true)
            .html(
                '<img src="/images/hourglass.gif" ' +
                'style="width:20px;height:20px;"> ' +
                'در حال ذخیره...'
            );

        //alert($("#salaryItemRuleAmount").val());

        //$("#salaryItemLoading").show();

        var url = (id == 0 ? "/SalaryItem/Create" : "/SalaryItem/Edit");

        $.ajax({
            url: url,
            type: "POST",
            data: form.serialize(),
            success: function(result) {
                if (result.success) {
                    $("#salaryItemModal").modal("hide");

                    Swal.fire({
                        icon: "success",
                        title: "قوانین با موفقیت ذخیره شد",
                        timer: 1200,
                        showConfirmButton: false
                    });
                    loadSalaryItems();
                }
                else {

                    $("#salaryItemRuleModalContent").html(result);


                    $.validator.unobtrusive.parse(
                        "#salaryItemRuleForm"
                    );

                }

            },


            error: function(xhr) {

                console.error(xhr);


                Swal.fire({

                    icon:
                        "error",

                    title:
                        "ذخیره انجام نشد",

                    text:
                        "خطایی هنگام ذخیره قوانین رخ داد."

                });

            },


            complete: function() {

                $("#salaryItemRuleLoading")
                    .hide();


                $("#btnSaveSalaryItemRule")
                    .prop("disabled", false)
                    .html("ثبت");

            }

        });


        return false;
    }
</script>
<script>

    $.validator.unobtrusive.parse(
        '#salaryItemForm'
    );

</script>